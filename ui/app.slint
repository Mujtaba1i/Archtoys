import { VerticalBox, HorizontalBox, ScrollView, LineEdit, CheckBox, Slider } from "std-widgets.slint";

// --- Global Theme Palettes ---
// One row in the main window (HEX, RGB, NAME, ...).
export struct FieldRow {
    key: string,
    label: string,
    value: string,
    // bumped by the app on every update; the row then shows `value` again
    rev: int,
    // the row Auto Copy copies (highlighted)
    auto-copy: bool,
    editable: bool,
}

// One line in the "Customize formats" panel.
export struct FormatOption {
    key: string,
    label: string,
    enabled: bool,
}

// One color in the search results.
export struct SearchCard {
    name: string,
    color: color,
    // the color in the first format after the name (shown on hover)
    value: string,
}

export global Skin {
    in-out property <bool> dark-mode: false;
    
    out property <brush> bg-color: dark-mode ? #202020 : #f3f3f3;
    out property <brush> content-bg: dark-mode ? #2d2d2d : #ffffff;
    out property <brush> text-main: dark-mode ? #eeeeee : #1a1a1a;
    out property <brush> text-muted: dark-mode ? #aaaaaa : #555555;
    out property <brush> border: dark-mode ? #444444 : #dcdcdc;
    out property <brush> icon-tint: dark-mode ? #ffffff : #333333;
}

// --- Custom Button with Image Icon ---
component CopyButton inherits Rectangle {
    in property <image> icon-source;
    callback clicked;
    
    width: 40px; 
    height: 40px; 
    border-radius: 4px;
    background: touch.pressed ? Skin.border : transparent;
    animate background { duration: 150ms; }

    VerticalLayout {
        padding: 15px;
        spacing: 6px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon-source;
                width: 18px; 
                height: 18px;
                colorize: Skin.icon-tint;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked() } }
}

component SettingsButton inherits Rectangle {
    in property <image> icon-source;
    callback clicked;
    
    width: 32px; 
    height: 32px; 
    border-radius: 4px;
    background: touch.pressed ? Skin.border : transparent;
    animate background { duration: 150ms; }

    VerticalLayout {
        padding: 8px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon-source;
                width: 18px; 
                height: 18px;
                colorize: Skin.icon-tint;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked() } }
}

// --- Text button in the app's theme (std Button follows the system theme
// instead of Dark Mode, so its text could be white on white) ---
component SkinButton inherits Rectangle {
    in property <string> text;
    callback clicked;

    height: 32px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Skin.border;
    background: touch.pressed ? Skin.border : touch.has-hover ? Skin.bg-color : Skin.content-bg;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: Skin.text-main;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// --- A search result: a block of color with its name in a dark oval. A dark
// oval with light text reads on any color, in both themes. ---
component SearchCardView inherits Rectangle {
    in property <SearchCard> card;
    in property <bool> highlighted;
    callback hover-changed(bool);
    callback clicked;

    border-radius: 8px;
    background: root.card.color;
    accessible-role: button;
    accessible-label: root.card.name;
    accessible-action-default => { root.clicked(); }

    if root.highlighted : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 10px;
        border-width: 2px;
        border-color: #3b82f6;
    }

    // The value shows only on the highlighted card, so the grid stays calm.
    if root.highlighted : Rectangle {
        y: 6px;
        height: 20px;
        width: min(parent.width - 8px, value-measure.preferred-width + 14px);
        x: (parent.width - self.width) / 2;
        border-radius: 10px;
        background: #000000b0;
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.card.value;
            color: #ffffff;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    value-measure := Text { text: root.card.value; font-size: 11px; visible: false; }

    // Long names are cut with "…" (the grid shows the highlighted one in full).
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: 22px;
        y: parent.height - self.height - 5px;
        border-radius: 11px;
        background: #1e1e1ee8;
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.card.name;
            color: #ffffff;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hover-changed(self.has-hover); }
    }
}

// --- The "Pick" Button ---
component PickButton inherits Rectangle {
    callback clicked;
    width: 90px; 
    height: 36px; 
    border-radius: 6px;
    
    background: touch.pressed ? Skin.border : Skin.content-bg;
    border-width: 1px; 
    border-color: Skin.border;

    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        alignment: center;
        
        Image { 
            source: @image-url("pick.svg");
            width: 16px; 
            height: 16px;
            colorize: Skin.icon-tint;
        }
        
        Text { 
            text: "Pick";
            color: Skin.text-main; 
            font-size: 16px; 
            font-weight: 800;
            vertical-alignment: center;
            horizontal-alignment: center; 
        }
    }
    touch := TouchArea { clicked => { root.clicked() } }
}

// --- Color Bubble (History) ---
component ColorBubble inherits Rectangle {
    in property <color> bubble-color;
    callback clicked;
    
    width: 26px; 
    height: 26px; 
    border-radius: 13px;
    background: bubble-color;
    border-width: 1px; 
    border-color: #00000020;
    
    TouchArea { clicked => { root.clicked() } }
}

// --- Data Row (HEX, RGB...) ---
component ValueRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    // The app bumps `rev` on every update. A text field the user has typed
    // into no longer follows bindings, so we copy `value` into it ourselves.
    in property <int> rev;
    in property <bool> editable: true;
    in property <bool> auto-copy: false;
    in property <color> accent: Skin.border;
    in property <image> icon-source: @image-url("copy.svg");

    callback edited(string);
    callback accepted(string);
    callback blurred(string);
    callback copy;

    init => { input.text = root.value; }
    changed rev => { input.text = root.value; }

    focus-release := FocusScope {
        enabled: true;
        width: 1px;
        height: 1px;
    }

    height: 48px;
    background: Skin.content-bg;
    border-radius: 6px;
    // The Auto Copy row gets a border in the picked color.
    border-width: root.auto-copy ? 2px : 1px;
    border-color: root.auto-copy ? root.accent : Skin.border;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;

        Text {
            text: root.label;
            color: Skin.text-muted;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            width: 52px;
        }

        input := TextInput {
            read-only: !root.editable;
            font-size: 14px;
            horizontal-stretch: 1;
            horizontal-alignment: center;
            vertical-alignment: center;
            color: Skin.text-main;
            single-line: true;

            edited => { root.edited(self.text); }
            // A read-only row (NAME) can be focused to select its text; only
            // rows you can type in are checked as a color.
            accepted => {
                if root.editable {
                    root.accepted(self.text);
                }
                focus-release.focus();
            }
            changed has-focus => {
                if !self.has-focus && root.editable {
                    root.blurred(self.text);
                }
            }
        }

        CopyButton {
            icon-source: root.icon-source;
            clicked => { root.copy(); }
        }
    }
}

// Small square button with an icon (used for the up/down arrows).
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 4px;
    background: touch.pressed && root.enabled ? Skin.border : transparent;
    opacity: root.enabled ? 1 : 0.3;
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        colorize: Skin.icon-tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// --- Pixel magnifier: 11x11 pixels shown 10x larger, center pixel outlined ---
component Magnifier inherits Rectangle {
    in property <image> source;
    width: 110px;
    height: 110px;
    border-radius: 6px;
    clip: true;
    background: #000000;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: fill;
        image-rendering: pixelated;
    }
    // outline of the pixel that will be picked
    Rectangle {
        x: 49px;
        y: 49px;
        width: 12px;
        height: 12px;
        border-width: 1px;
        border-color: #ffffff;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 10px;
            height: 10px;
            border-width: 1px;
            border-color: #000000;
        }
    }
}

// --- Preview card: magnifier + swatch + HEX (used by both pickers) ---
component PreviewCard inherits Rectangle {
    in property <image> magnifier;
    in property <color> preview-color;
    in property <string> preview-hex;

    width: 126px;
    height: 158px;
    border-radius: 8px;
    background: #1f1f1fe6;
    border-width: 1px;
    border-color: #00000030;
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000060;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        Magnifier { source: root.magnifier; }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: root.preview-color;
                border-width: 1px;
                border-color: #ffffff40;
            }
            Text {
                text: root.preview-hex;
                color: #ffffff;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// --- Live Picker Overlay (X11: follows the cursor) ---
export component PickerOverlay inherits Window {
    width: 126px;
    height: 158px;
    background: #00000000;
    no-frame: true;
    always-on-top: true;

    in-out property <color> preview-color: #ffffff;
    in-out property <string> preview-hex: "#ffffff";
    in-out property <image> magnifier;

    PreviewCard {
        magnifier: root.magnifier;
        preview-color: root.preview-color;
        preview-hex: root.preview-hex;
    }
}

// --- Transparent full-screen input shield (X11 picker session) ---
// Fully transparent: even 1/255 opacity darkens picked colors by one step
// (#FF0000 would read as #FE0000). X11 input doesn't depend on opacity.
export component PickerShieldWindow inherits Window {
    width: 1px;
    height: 1px;
    full-screen: true;
    no-frame: true;
    always-on-top: true;
    background: #00000000;
    title: "Archtoys Picker Shield";

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000000;
        TouchArea { }
    }
}

// --- Freeze-frame picker: shows a screenshot fullscreen; you pick from it ---
// No fixed width/height here: `width: 1px` would shrink the *contents* to
// one pixel even though the window itself is fullscreen.
export component FreezePickerWindow inherits Window {
    full-screen: true;
    no-frame: true;
    always-on-top: true;
    background: #000000;
    title: "Archtoys Picker";

    in-out property <image> screenshot-image;
    in-out property <image> magnifier;
    in-out property <color> preview-color: #000000;
    in-out property <string> preview-hex: "";
    in-out property <length> cursor-x: -1000px;
    in-out property <length> cursor-y: -1000px;

    // logical pixel coordinates inside this window
    callback pointer-moved(length, length);
    callback pick-at(length, length);
    callback cancel-pick();

    Image {
        width: parent.width;
        height: parent.height;
        source: root.screenshot-image;
        image-fit: fill;
    }

    area := TouchArea {
        mouse-cursor: crosshair;
        // `moved` only fires while a button is held, so watch the position.
        changed mouse-x => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        changed mouse-y => { root.pointer-moved(self.mouse-x, self.mouse-y); }
        clicked => { root.pick-at(self.mouse-x, self.mouse-y); }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.cancel-pick();
            }
        }
    }

    FocusScope {
        enabled: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-pick();
                return accept;
            }
            reject
        }
    }

    if root.preview-hex != "" : PreviewCard {
        magnifier: root.magnifier;
        preview-color: root.preview-color;
        preview-hex: root.preview-hex;
        // beside the cursor; flips to the other side near the screen edges
        x: root.cursor-x + 20px + self.width > root.width ? root.cursor-x - 20px - self.width : root.cursor-x + 20px;
        y: root.cursor-y + 20px + self.height > root.height ? root.cursor-y - 20px - self.height : root.cursor-y + 20px;
    }
}

export component AppWindow inherits Window {
    title: "Archtoys";
    // During a freeze-frame pick with "Minimize on Pick" off, the window
    // stays open above the screenshot (X11 needs always-on-top for that).
    always-on-top: root.keep-on-top;
    // Used on X11. On Wayland the desktop takes the icon from archtoys.desktop.
    icon: @image-url("../packaging/archtoys-256.png");
    preferred-width: 520px;
    // tall enough for the 5 default rows; more rows scroll
    preferred-height: 410px;
    min-width: 480px;
    min-height: 320px;
    max-width: 900px;
    max-height: 620px;
    background: Skin.bg-color;
    // Start with the keyboard on the window itself, so Ctrl+F works at once.
    forward-focus: defocus-scope;

    in property <color> current-color: #cbb6ac;
    in property <[color]> history-model: [#e0e0e0, #4a5a6a, #cbb6ac, #8c8b5c];
    
    in-out property <color> shade-lighter-2;
    in-out property <color> shade-lighter-1;
    in-out property <color> shade-darker-1;
    in-out property <color> shade-darker-2;

    in-out property <bool> settings-open: false;
    in-out property <bool> setting-minimize: false;
    in-out property <bool> setting-minimize-tray: true;
    in-out property <bool> setting-autocopy: false;
    in-out property <bool> setting-autostart: false;
    in-out property <string> setting-hotkey: "Ctrl+Super+C";
    in-out property <bool> setting-hotkey-recording: false;
    // True when the desktop (e.g. KDE) owns the shortcut; it must be changed
    // in the desktop's settings, and `hotkey-display` shows the real one.
    in-out property <bool> hotkey-system-managed: false;
    in-out property <string> hotkey-display: "";
    // Shown briefly when a typed color can't be understood.
    in-out property <string> input-error: "";
    in-out property <bool> keep-on-top: false;
    in property <[FieldRow]> fields;
    in property <[FormatOption]> format-options;
    in-out property <bool> formats-open: false;
    in-out property <bool> picking: false;

    callback pick-color();
    callback copy-to-clipboard(string);
    callback history-clicked(int);
    callback shade-clicked(float);
    callback value-edited(string, string);
    callback value-accepted(string, string);
    callback value-blurred(string, string);
    callback hotkey-captured(string, bool, bool, bool, bool);
    callback settings-changed();
    callback settings-opened();
    callback format-toggled(string, bool);
    callback format-moved(string, int);
    callback cancel-pick();
    callback open-hotkey-settings();
    callback clear-history();
    callback report-problem();

    // --- Color search ---
    in-out property <bool> search-open: false;
    in property <[SearchCard]> search-results;
    // "Showing results for pink", or a hint when nothing matches
    in property <string> search-note;
    // bumped by the app for every new search (the grid scrolls back to the top)
    in property <int> search-generation;
    // the card under the mouse or chosen with the arrow keys (-1: none)
    in-out property <int> search-highlight: -1;
    // true while the arrow keys move the highlight (then the grid follows it)
    property <bool> search-keyboard: false;
    // 0 = closed, 1 = open; animated, so the bar grows and shrinks smoothly
    property <float> search-t: root.search-open ? 1 : 0;
    animate search-t { duration: 180ms; easing: ease-out; }
    callback search-changed(string);
    callback search-hovered(int);
    callback search-applied(int);
    callback search-closed();
    callback search-load-more();

    function open-search() {
        root.formats-open = false;
        root.settings-open = false;
        root.search-open = true;
        root.search-highlight = -1;
        search-input.text = "";
        root.search-changed("");
        search-input.focus();
    }

    // Ctrl+F opens the search, and closes it when it is open.
    function toggle-search() {
        if root.search-open {
            root.close-search();
        } else {
            root.open-search();
        }
    }

    // Esc, Ctrl+F, a click elsewhere, or another panel: the previous color comes back.
    function close-search() {
        if root.search-open {
            root.search-open = false;
            root.search-highlight = -1;
            root.search-closed();
            defocus-scope.focus();
        }
    }

    function apply-search(index: int) {
        if index >= 0 && index < root.search-results.length {
            root.search-applied(index);
            root.close-search();
        }
    }

    // Arrow keys: +-1 moves along a row, +-5 moves a row. Up from the first
    // row goes back to the text.
    function move-highlight(delta: int) {
        if root.search-results.length > 0 {
            root.search-keyboard = true;
            root.search-highlight = root.search-highlight < 0 ? (delta > 0 ? 0 : -1)
                : root.search-highlight + delta < 0 ? (delta == -5 ? -1 : root.search-highlight)
                : Math.min(root.search-highlight + delta, root.search-results.length - 1);
            if root.search-highlight > root.search-results.length - 11 {
                root.search-load-more();
            }
            root.search-hovered(root.search-highlight);
        }
    }

    // Esc cancels a pick while this window has the keyboard.
    pick-scope := FocusScope {
        enabled: root.picking;
        width: 1px;
        height: 1px;
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-pick();
                return accept;
            }
            reject
        }
    }
    public function focus-pick-scope() {
        pick-scope.focus();
    }


    hotkey-record-scope := FocusScope {
        enabled: root.setting-hotkey-recording;
        width: 1px;
        height: 1px;
        key-pressed(event) => {
            if !root.setting-hotkey-recording {
                return reject;
            }
            if event.text == Key.Escape {
                root.setting-hotkey-recording = false;
                return accept;
            }
            if event.text == Key.Control || event.text == Key.ControlR
                || event.text == Key.Shift || event.text == Key.ShiftR
                || event.text == Key.Alt || event.text == Key.AltGr
                || event.text == Key.Meta || event.text == Key.MetaR {
                return accept;
            }
            if !event.modifiers.control
                && !event.modifiers.alt
                && !event.modifiers.shift
                && !event.modifiers.meta {
                return accept;
            }
            root.hotkey-captured(
                event.text,
                event.modifiers.control,
                event.modifiers.alt,
                event.modifiers.shift,
                event.modifiers.meta
            );
            root.setting-hotkey-recording = false;
            return accept;
        }
    }

    TouchArea {
        clicked => {
            defocus-scope.focus();
        }
    }

    // Holds the focus when nothing else should. It wraps the window's content,
    // so Ctrl+F works from anywhere, including while typing in a row.
    defocus-scope := FocusScope {
    key-pressed(event) => {
        if event.modifiers.control && (event.text == "f" || event.text == "F") {
            root.toggle-search();
            return accept;
        }
        reject
    }

    VerticalBox {
        padding: 14px; 
        spacing: 0px;

        // Header
        HorizontalLayout {
            height: 50px;
            spacing: 15px;
            padding-bottom: 10px;

            HorizontalLayout {
                spacing: 15px;

                pick-button := PickButton { clicked => { root.pick-color(); } }

                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    Flickable {
                        interactive: true;
                        viewport-width: (root.history-model.length * 40px);
                        HorizontalLayout {
                            spacing: 12px;
                            padding-top: 5px;
                            for col[i] in root.history-model : ColorBubble {
                                bubble-color: col;
                                clicked => { root.history-clicked(i); }
                            }
                            Rectangle { horizontal-stretch: 0;
                             }
                        }
                    }
                }
            }

            // --- spacer that pushes settings button to far right ---

            search-button := SettingsButton {
                icon-source: @image-url("search.svg");
                accessible-role: button;
                accessible-label: "Search colors (Ctrl+F)";
                clicked => { root.open-search(); }
            }

            SettingsButton {
                icon-source: @image-url("sliders.svg");
                clicked => {
                    root.close-search();
                    root.settings-open = false;
                    root.formats-open = !root.formats-open;
                }
            }

            SettingsButton {
                icon-source: @image-url("settings.svg");
                clicked => {
                    root.close-search();
                    root.formats-open = false;
                    root.settings-open = !root.settings-open;
                    if root.settings-open { root.settings-opened(); }
                }
            }
        }

        // Divider
        Rectangle { 
            height: 2px; 
            background: Skin.border;
        }
        Rectangle { height: 12px; } // Spacing after divider

        // Main Content
        HorizontalLayout {
            padding-top: 4px; 
            spacing: 16px;

            // Shade Bar
            shade-bar := Rectangle {
                width: 36px; 
                vertical-stretch: 1;
                border-radius: 6px; 
                clip: true;
                
                VerticalLayout {
                    Rectangle { background: root.shade-lighter-2; vertical-stretch: 1; TouchArea { clicked => { root.shade-clicked(1.5) } } }
                    Rectangle { background: root.shade-lighter-1; vertical-stretch: 1; TouchArea { clicked => { root.shade-clicked(1.2) } } }
                    Rectangle { background: root.current-color; vertical-stretch: 1; TouchArea { clicked => { root.shade-clicked(1.0) } } }
                    Rectangle { background: root.shade-darker-1; vertical-stretch: 1; TouchArea { clicked => { root.shade-clicked(0.7) } } }
                    Rectangle { background: root.shade-darker-2; vertical-stretch: 1; TouchArea { clicked => { root.shade-clicked(0.5) } } }
                }
            }

            // Value Rows (scroll up/down if there are many)
            ScrollView {
                horizontal-stretch: 1;
                viewport-width: self.visible-width;
                VerticalLayout {
                    spacing: 10px;
                    for row in root.fields : ValueRow {
                        label: row.label;
                        value: row.value;
                        rev: row.rev;
                        editable: row.editable;
                        auto-copy: row.auto-copy;
                        accent: root.current-color;
                        copy => { root.copy-to-clipboard(row.value) }
                        edited(txt) => { root.value-edited(row.key, txt) }
                        accepted(txt) => { root.value-accepted(row.key, txt) }
                        blurred(txt) => { root.value-blurred(row.key, txt) }
                    }
                }
            }
        }
    }
    } // defocus-scope

    // --- Color search ---
    // While searching, a click anywhere else closes it.
    if root.search-open : TouchArea {
        clicked => { root.close-search(); }
    }

    // The results open under the header, right of the shade bar, so the shade
    // bar keeps showing the color under the mouse.
    if root.search-open : Rectangle {
        x: shade-bar.absolute-position.x + shade-bar.width + 16px;
        y: search-button.absolute-position.y + search-button.height + 14px;
        width: root.width - self.x - 14px;
        height: root.height - self.y - 14px;
        background: Skin.content-bg;
        border-radius: 8px;
        border-width: 1px;
        border-color: Skin.border;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;

        TouchArea { } // clicks inside don't close it

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            Text {
                text: root.search-note != "" ? root.search-note
                    : root.search-results.length > 0 ? "Results"
                    : "Type a color name, a word like sky, or a code like #FF46A2";
                color: Skin.text-muted;
                font-size: 12px;
                wrap: word-wrap;
            }

            grid := Flickable {
                vertical-stretch: 1;
                property <length> gap: 6px;
                property <length> edge: 4px; // room for the highlight outline
                property <length> card-w: (self.width - 2 * self.edge - 4 * self.gap) / 5;
                property <length> card-h: self.card-w * 0.9;
                property <int> generation: root.search-generation;
                property <int> highlight: root.search-highlight;
                viewport-height: Math.ceil(root.search-results.length / 5) * (self.card-h + self.gap) + 2 * self.edge;

                changed generation => { self.viewport-y = 0; }
                changed viewport-y => {
                    if -self.viewport-y + self.height > self.viewport-height - 2 * (self.card-h + self.gap) {
                        root.search-load-more();
                    }
                }
                // The arrow keys move the highlight: keep it in view.
                changed highlight => {
                    if root.search-keyboard && self.highlight >= 0 {
                        if self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) < -self.viewport-y {
                            self.viewport-y = -Math.floor(self.highlight / 5) * (self.card-h + self.gap);
                        } else if self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) + self.card-h + self.edge > -self.viewport-y + self.height {
                            self.viewport-y = -(2 * self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) + self.card-h - self.height);
                        }
                    }
                }

                for card[i] in root.search-results : SearchCardView {
                    x: grid.edge + Math.mod(i, 5) * (grid.card-w + grid.gap);
                    y: grid.edge + Math.floor(i / 5) * (grid.card-h + grid.gap);
                    width: grid.card-w;
                    height: grid.card-h;
                    card: card;
                    highlighted: root.search-highlight == i;
                    hover-changed(on) => {
                        root.search-keyboard = false;
                        if on {
                            root.search-highlight = i;
                            root.search-hovered(i);
                        } else if root.search-highlight == i {
                            root.search-highlight = -1;
                            root.search-hovered(-1);
                        }
                    }
                    clicked => { root.apply-search(i); }
                }

                // The highlighted card's full name, drawn over its neighbours.
                if root.search-highlight >= 0 && root.search-highlight < root.search-results.length : Rectangle {
                    property <length> card-x: grid.edge + Math.mod(root.search-highlight, 5) * (grid.card-w + grid.gap);
                    width: Math.min(grid.width - 2 * grid.edge, Math.max(grid.card-w - 8px, full-name.preferred-width + 16px));
                    height: 22px;
                    x: Math.max(grid.edge, Math.min(self.card-x + (grid.card-w - self.width) / 2, grid.width - grid.edge - self.width));
                    y: grid.edge + Math.floor(root.search-highlight / 5) * (grid.card-h + grid.gap) + grid.card-h - self.height - 5px;
                    border-radius: 11px;
                    background: #1e1e1e;
                    full-name := Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.search-results[root.search-highlight].name;
                        color: #ffffff;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // The search bar grows out of the search button, over the history row.
    Rectangle {
        property <length> right: search-button.absolute-position.x + search-button.width;
        property <length> full: self.right - (pick-button.absolute-position.x + pick-button.width + 15px);
        visible: root.search-open || root.search-t > 0.01;
        y: search-button.absolute-position.y;
        height: search-button.height;
        width: search-button.width + (self.full - search-button.width) * root.search-t;
        x: self.right - self.width;
        border-radius: self.height / 2;
        background: Skin.content-bg;
        border-width: 1px;
        border-color: Skin.border;

        TouchArea { } // clicks on the bar don't close it

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 12px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("search.svg");
                    width: 16px;
                    height: 16px;
                    colorize: Skin.icon-tint;
                }
            }

            FocusScope {
                horizontal-stretch: 1;
                // Before the text field sees them: arrows move through the
                // grid, Esc closes. Left/Right only once a card is chosen.
                capture-key-pressed(event) => {
                    if event.text == Key.Escape
                        || (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                        root.close-search();
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.move-highlight(5);
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        root.move-highlight(-5);
                        return accept;
                    }
                    if root.search-highlight >= 0 && event.text == Key.RightArrow {
                        root.move-highlight(1);
                        return accept;
                    }
                    if root.search-highlight >= 0 && event.text == Key.LeftArrow {
                        root.move-highlight(-1);
                        return accept;
                    }
                    reject
                }

                search-input := TextInput {
                    width: 100%;
                    height: 100%;
                    color: Skin.text-main;
                    font-size: 14px;
                    single-line: true;
                    vertical-alignment: center;
                    accessible-label: "Search colors";
                    edited => {
                        root.search-highlight = -1;
                        root.search-changed(self.text);
                    }
                    accepted => {
                        root.apply-search(root.search-highlight >= 0 ? root.search-highlight : 0);
                    }
                }
                if search-input.text == "" : Text {
                    width: 100%;
                    height: 100%;
                    text: "Search colors";
                    color: Skin.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Customize formats overlay
    if root.formats-open : Rectangle {
        width: 100%;
        height: 100%;
        background: #00000050;
        TouchArea { clicked => { root.formats-open = false; } }

        Rectangle {
            x: parent.width - 260px - 20px;
            y: 60px;
            width: 260px;
            height: parent.height - 80px;
            background: Skin.content-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Skin.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000040;

            TouchArea { clicked => { } }

            ScrollView {
                width: parent.width;
                height: parent.height;
                viewport-width: self.visible-width;

                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    Text {
                        text: "Customize formats";
                        font-weight: 700;
                        color: Skin.text-main;
                        font-size: 16px;
                    }
                    Text {
                        text: "Auto Copy uses the top format.";
                        color: Skin.text-muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 1px; background: Skin.border; }

                    for opt[i] in root.format-options : HorizontalLayout {
                        spacing: 6px;
                        CheckBox {
                            checked: opt.enabled;
                            toggled => { root.format-toggled(opt.key, self.checked); }
                        }
                        Text {
                            text: opt.label;
                            color: opt.enabled ? Skin.text-main : Skin.text-muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        IconButton {
                            icon: @image-url("chevron-up.svg");
                            enabled: i > 0;
                            clicked => { root.format-moved(opt.key, -1); }
                        }
                        IconButton {
                            icon: @image-url("chevron-down.svg");
                            enabled: i < root.format-options.length - 1;
                            clicked => { root.format-moved(opt.key, 1); }
                        }
                    }
                }
            }
        }
    }

    // Settings Overlay
    if root.settings-open : Rectangle {
        width: 100%; 
        height: 100%;
        background: #00000050;
        TouchArea {
            clicked => {
                defocus-scope.focus();
                root.settings-open = false;
            }
        }

        Rectangle {
            x: parent.width - 240px - 20px;
            y: 60px;
            width: 240px; 
            height: parent.height - 80px;
            background: Skin.content-bg;
            border-radius: 8px;
            border-width: 1px; 
            border-color: Skin.border;
            drop-shadow-blur: 12px; 
            drop-shadow-color: #00000040;

            TouchArea { clicked => { } }

            ScrollView {
                width: parent.width;
                height: parent.height;
                // Fit the width: scroll up/down only, never sideways.
                viewport-width: self.visible-width;

                VerticalLayout {
                    padding: 16px; 
                    spacing: 12px;
                    
                    Text { 
                        text: "Settings"; 
                        font-weight: 700; 
                        color: Skin.text-main; 
                        font-size: 16px; 
                    }
                    
                    Rectangle { 
                        height: 1px; 
                        background: Skin.border; 
                    }
                    
                    HorizontalLayout {
                        spacing: 10px;
                        Text { 
                            text: "Dark Mode"; 
                            color: Skin.text-main; 
                            vertical-alignment: center; 
                            horizontal-stretch: 1; 
                        }
                        CheckBox { checked <=> Skin.dark-mode; toggled => { root.settings-changed(); } }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { 
                            text: "Minimize to tray on close"; 
                            color: Skin.text-main; 
                            vertical-alignment: center; 
                            horizontal-stretch: 1; 
                        }
                        CheckBox { checked <=> root.setting-minimize-tray; toggled => { root.settings-changed(); } }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { 
                            text: "Minimize on Pick"; 
                            color: Skin.text-main; 
                            vertical-alignment: center; 
                            horizontal-stretch: 1; 
                        }
                        CheckBox { checked <=> root.setting-minimize; toggled => { root.settings-changed(); } }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text { 
                            text: "Auto Copy"; 
                            color: Skin.text-main; 
                            vertical-alignment: center; 
                            horizontal-stretch: 1; 
                        }
                        CheckBox { checked <=> root.setting-autocopy; toggled => { root.settings-changed(); } }
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            text: "Run on Startup";
                            color: Skin.text-main;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        CheckBox { checked <=> root.setting-autostart; toggled => { root.settings-changed(); } }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Global Hotkey";
                            color: Skin.text-main;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                        if !root.hotkey-system-managed : SkinButton {
                            text: root.setting-hotkey-recording ? "Press keys..." : root.setting-hotkey;
                            clicked => {
                                root.setting-hotkey-recording = true;
                                hotkey-record-scope.focus();
                            }
                        }
                        if root.hotkey-system-managed : VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.hotkey-display == "" ? "Not set" : root.hotkey-display;
                                color: Skin.text-main;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            SkinButton {
                                text: "Change in System Settings";
                                clicked => { root.open-hotkey-settings(); }
                            }
                            Text {
                                text: "Your desktop manages this shortcut.";
                                color: Skin.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Skin.border;
                    }

                    SkinButton {
                        text: "Clear History";
                        height: 32px;
                        horizontal-stretch: 1;
                        clicked => { root.clear-history(); }
                    }

                    // Opens GitHub's new-issue page with the details filled in.
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: report-touch.pressed ? #b02a2a : report-touch.has-hover ? #c43030 : #d93636;
                        accessible-role: button;
                        accessible-label: "Report a problem";
                        accessible-action-default => { root.report-problem(); }
                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("report.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: #ffffff;
                                }
                            }
                            Text {
                                text: "Report a problem";
                                color: #ffffff;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        report-touch := TouchArea { clicked => { root.report-problem(); } }
                    }
                }
            }
        }
    }


    // Error message for invalid input, at the bottom of the window.
    if root.input-error != "" : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 12px;
        width: error-text.preferred-width + 24px;
        height: 30px;
        border-radius: 6px;
        background: #d93636;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000040;
        error-text := Text {
            text: root.input-error;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
