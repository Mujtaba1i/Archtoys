import { ScrollView, Palette, AboutSlint } from "std-widgets.slint";
import { FieldRow, FormatOption, SearchCard, ShadeCell, Skin, GlowMath, RingGlow, RoundGradient, HeaderButton, CopyIcon, PillButton, ActionButton, Switch, Segmented, SettingCard, SectionLabel, IconButton } from "common.slint";
import { TitleBar, Sidebar, HomePage } from "shell.slint";
import { TextExtractorPage, TextEntry } from "text.slint";
// Rust reaches these through this file
export { FieldRow, FormatOption, SearchCard, ShadeCell, Skin } from "common.slint";
export { TextEntry } from "text.slint";

// --- A search result: a block of color with its name in a dark oval. A dark
// oval with light text reads on any color, in both themes. ---
component SearchCardView inherits Rectangle {
    in property <SearchCard> card;
    in property <bool> highlighted;
    callback hover-changed(bool);
    callback clicked;

    border-radius: 8px;
    background: root.card.color;
    accessible-role: button;
    accessible-label: root.card.name;
    accessible-action-default => { root.clicked(); }

    if root.highlighted : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 10px;
        border-width: 2px;
        border-color: Skin.accent;
    }

    // The value shows only on the highlighted card, so the grid stays calm.
    if root.highlighted : Rectangle {
        y: 6px;
        height: 20px;
        width: min(parent.width - 8px, value-measure.preferred-width + 14px);
        x: (parent.width - self.width) / 2;
        border-radius: 10px;
        background: #000000b0;
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.card.value;
            color: #ffffff;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    value-measure := Text { text: root.card.value; font-size: 11px; visible: false; }

    // Long names are cut with "…" (the grid shows the highlighted one in full).
    Rectangle {
        x: 4px;
        width: parent.width - 8px;
        height: 22px;
        y: parent.height - self.height - 5px;
        border-radius: 11px;
        background: #1b1c20e8;
        Text {
            x: 6px;
            width: parent.width - 12px;
            height: parent.height;
            text: root.card.name;
            color: #ffffff;
            font-size: 11px;
            overflow: elide;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => { root.clicked(); }
        changed has-hover => { root.hover-changed(self.has-hover); }
    }
}

// A color in the history row.
component ColorBubble inherits Rectangle {
    in property <color> bubble-color;
    callback clicked;

    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: bubble-color;
    border-width: 1px;
    // so a color close to the background still shows
    border-color: Skin.pick(#ffffff30, #00000020);
    TouchArea { clicked => { root.clicked(); } }
}

// The big color card: the first format, which is also what Auto Copy copies.
// Clicking the value's text edits it; the rest of the card doesn't.
component ColorCard inherits Rectangle {
    in property <color> card-color;
    // text color: dark or white, whichever reads on `color`
    in property <color> ink;
    in property <string> name;
    in property <string> label;
    in property <string> value;
    // The app bumps `rev` on every update. A text field the user has typed
    // into no longer follows bindings, so we copy `value` into it ourselves.
    in property <int> rev;
    in property <bool> gradient;
    // While searching, a click anywhere on the card closes the search.
    in property <bool> closes;

    callback edited(string);
    callback accepted(string);
    callback blurred(string);
    callback copy;
    callback close;

    init => { input.text = root.value; }
    changed rev => { input.text = root.value; }

    // the color and text color glide to a new color instead of jumping
    property <color> shown: root.card-color;
    // false while the app starts: the saved color shows at once
    in property <bool> animated: true;
    animate shown { duration: root.animated ? 220ms : 0ms; easing: ease-out; }
    property <color> shown-ink: root.ink;
    animate shown-ink { duration: root.animated ? 220ms : 0ms; easing: ease-out; }

    border-radius: 22px;
    // The gradient starts behind the text, so the text color still fits.
    property <color> sheen: root.shown.mix(Skin.pick(#000000, #ffffff), 0.5);
    property <brush> sheen-fill: @linear-gradient(45deg, root.shown 0%, root.shown 35%, self.sheen 100%);
    // The CPU draws each pair of stops as its own strip, with rounded edges, so
    // at some sizes a 1 px gap shows between them (a dark line across the
    // card). There the card is filled with the color and RoundGradient draws
    // one strip on top (two stops): a gap only shows that same color.
    property <brush> sheen-strip: @linear-gradient(45deg, root.shown 35%, self.sheen 100%);
    background: !root.gradient || !Skin.real-shadows ? root.shown : self.sheen-fill;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 10px;
    drop-shadow-color: Skin.real-shadows ? root.shown.transparentize(0.7 - 0.1 * Skin.dark-t) : transparent;
    RingGlow {
        width: root.width;
        height: root.height;
        glow: root.shown.transparentize(0.7 - 0.1 * Skin.dark-t);
        blur: 28px;
        radius: root.border-radius;
        offset-y: 10px;
        cover: root.background;
    }
    if root.gradient && !Skin.real-shadows : RoundGradient {
        width: root.width;
        height: root.height;
        fill: root.sheen-strip;
        radius: root.border-radius;
    }

    focus-release := FocusScope {
        width: 1px;
        height: 1px;
    }

    VerticalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-bottom: 16px;
        alignment: end;

        if root.name != "" : Text {
            text: root.name;
            color: root.shown-ink;
            opacity: 0.9;
            font-size: 14px;
            overflow: elide;
        }
        Text {
            text: root.label;
            color: root.shown-ink;
            opacity: 0.75;
            font-size: 11px;
            letter-spacing: 1px;
        }
        HorizontalLayout {
            alignment: start;
            input := TextInput {
                min-width: 60px;
                max-width: root.width - 40px;
                color: root.shown-ink;
                // smaller when a long value (OKLCH, CMYK) doesn't fit
                font-size: big-measure.preferred-width > root.width - 80px ? 28px : 38px;
                font-weight: 600;
                single-line: true;
                selection-background-color: root.shown-ink.transparentize(0.7);
                selection-foreground-color: root.shown-ink;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                accepted => {
                    root.accepted(self.text);
                    focus-release.focus();
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.blurred(self.text);
                    }
                }
            }
        }
    }
    big-measure := Text {
        visible: false;
        text: input.text;
        font-size: 38px;
        font-weight: 600;
    }

    CopyIcon {
        x: parent.width - self.width - 12px;
        y: 12px;
        tint: root.shown-ink;
        clicked => { root.copy(); }
    }

    if root.closes : TouchArea { clicked => { root.close(); } }
}

// One format box (formats 2..n): type into it to change the color.
component FormatBox inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <int> rev; // see ColorCard

    callback edited(string);
    callback accepted(string);
    callback blurred(string);
    callback copy;

    init => { input.text = root.value; }
    changed rev => { input.text = root.value; }

    height: 54px;
    border-radius: 14px;
    background: Skin.surface;
    border-width: 1px;
    border-color: input.has-focus ? Skin.accent : Skin.border;
    animate border-color { duration: 150ms; }

    // a click anywhere on the box (the label too) puts the cursor in it
    TouchArea {
        mouse-cursor: text;
        clicked => { input.focus(); }
    }

    focus-release := FocusScope {
        width: 1px;
        height: 1px;
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Skin.text-muted;
                font-size: 11px;
                letter-spacing: 0.6px;
            }
            input := TextInput {
                color: Skin.text-main;
                font-size: 15px;
                single-line: true;
                accessible-label: root.label;
                edited => { root.edited(self.text); }
                accepted => {
                    root.accepted(self.text);
                    focus-release.focus();
                }
                changed has-focus => {
                    if !self.has-focus {
                        root.blurred(self.text);
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            CopyIcon { clicked => { root.copy(); } }
        }
    }
}

// One shade: its name (when names are on), the format, and its value.
component ShadeTile inherits Rectangle {
    in property <ShadeCell> cell;
    in property <string> label;
    callback clicked;
    // the pen on the selected color: opens the color editor
    callback edit;
    callback pen-hover(bool);

    in property <bool> animated: true; // see ColorCard
    // the round ends of the strip: the first tile's left corners, the last one's
    // right (the strip clips too, but rounded clipping needs OpenGL)
    in property <length> left-radius;
    in property <length> right-radius;
    background: root.cell.color;
    animate background { duration: root.animated ? 220ms : 0ms; easing: ease-out; }
    border-top-left-radius: root.left-radius;
    border-bottom-left-radius: root.left-radius;
    border-top-right-radius: root.right-radius;
    border-bottom-right-radius: root.right-radius;
    accessible-role: button;
    accessible-label: root.cell.current ? root.cell.value + " (the selected color)" : root.cell.value;
    accessible-action-default => { touch.clicked(); }

    // hover: a soft tint over the whole tile
    Rectangle {
        border-top-left-radius: root.left-radius;
        border-bottom-left-radius: root.left-radius;
        border-top-right-radius: root.right-radius;
        border-bottom-right-radius: root.right-radius;
        background: root.cell.ink.transparentize(touch.pressed ? 0.8 : touch.has-hover ? 0.88 : 1);
        animate background { duration: 150ms; }
    }

    // the selected color itself: a check mark instead of being clickable
    Image {
        x: parent.width - self.width - 8px;
        y: 8px;
        width: 14px;
        height: 14px;
        source: @image-url("check.svg");
        colorize: root.cell.ink;
        opacity: root.cell.current ? 0.85 : 0;
        animate opacity { duration: 150ms; }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 1px;
        alignment: end;
        if root.cell.name != "" : Text {
            text: root.cell.name;
            color: root.cell.ink;
            font-size: 10.5px;
            overflow: elide;
        }
        Text {
            text: root.label;
            color: root.cell.ink;
            opacity: 0.7;
            font-size: 9px;
            letter-spacing: 0.6px;
        }
        Text {
            text: root.cell.value;
            color: root.cell.ink;
            // smaller when the value doesn't fit the tile
            font-size: measure.preferred-width > root.width - 16px ? 9px : 11px;
            overflow: elide;
        }
    }
    measure := Text {
        visible: false;
        text: root.cell.value;
        font-size: 11px;
    }

    touch := TouchArea {
        enabled: !root.cell.current;
        clicked => { root.clicked(); }
    }

    // the selected color: a pen opens the color editor
    if root.cell.current : Rectangle {
        x: 6px;
        y: 6px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: root.cell.ink.transparentize(pen-touch.pressed ? 0.7 : pen-touch.has-hover ? 0.78 : 0.86);
        animate background { duration: 120ms; }
        accessible-role: button;
        accessible-label: "Edit or compare this color";
        accessible-action-default => { root.edit(); }
        Image {
            source: @image-url("pen.svg");
            width: 14px;
            height: 14px;
            colorize: root.cell.ink;
        }
        pen-touch := TouchArea {
            clicked => { root.edit(); }
            changed has-hover => { root.pen-hover(self.has-hover); }
        }
    }
}

// --- Pixel magnifier: 11x11 pixels shown 10x larger, center pixel outlined ---
component Magnifier inherits Rectangle {
    in property <image> source;
    width: 110px;
    height: 110px;
    border-radius: 6px;
    clip: true;
    background: #000000;

    Image {
        width: parent.width;
        height: parent.height;
        source: root.source;
        image-fit: fill;
        image-rendering: pixelated;
    }
    // the round corners when drawn on the CPU (it clips square): the preview
    // card's color over the image's corners
    Rectangle {
        visible: !Skin.real-shadows;
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.border-radius + 3px;
        border-width: 3px;
        border-color: #1f1f1fe6;
    }
    // outline of the pixel that will be picked
    Rectangle {
        x: 49px;
        y: 49px;
        width: 12px;
        height: 12px;
        border-width: 1px;
        border-color: #ffffff;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 10px;
            height: 10px;
            border-width: 1px;
            border-color: #000000;
        }
    }
}

// --- Preview card: magnifier + swatch + the value in the first format (both pickers) ---
component PreviewCard inherits Rectangle {
    in property <image> magnifier;
    in property <color> preview-color;
    in property <string> preview-hex;

    // wider for long values (CMYK, HSL ...); an even number of pixels, so the
    // centred magnifier sits on whole pixels (else OpenGL blurs its marker)
    width: 2px * Math.ceil(max(126px, value.preferred-width + 46px) / 2px);
    height: 158px;
    border-radius: 8px;
    // drawn on the CPU, the glow's cover paints it (once: it's see-through)
    background: Skin.real-shadows ? #1f1f1fe6 : transparent;
    border-width: 1px;
    border-color: Skin.real-shadows ? #00000030 : transparent;
    drop-shadow-blur: 10px;
    drop-shadow-color: Skin.real-shadows ? #00000060 : transparent;
    RingGlow {
        width: root.width;
        height: root.height;
        glow: #00000060;
        blur: 10px;
        radius: root.border-radius;
        cover: #1f1f1fe6;
        cover-border: #00000030;
        cover-border-width: root.border-width;
    }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Magnifier { source: root.magnifier; }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                width: 22px;
                height: 22px;
                border-radius: 4px;
                background: root.preview-color;
                border-width: 1px;
                border-color: #ffffff40;
            }
            value := Text {
                text: root.preview-hex;
                color: #ffffff;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

// --- Live Picker Overlay (X11: follows the cursor) ---
export component PickerOverlay inherits Window {
    width: card.width;
    height: 158px;
    background: #00000000;
    no-frame: true;
    always-on-top: true;

    in-out property <color> preview-color: #ffffff;
    in-out property <string> preview-hex: "#ffffff";
    in-out property <image> magnifier;
    // wider for long values; Rust needs it to keep the overlay on the monitor
    out property <length> card-width: card.width;

    card := PreviewCard {
        magnifier: root.magnifier;
        preview-color: root.preview-color;
        preview-hex: root.preview-hex;
    }
}

// --- Transparent full-screen input shield (X11 picker session) ---
// Fully transparent: even 1/255 opacity darkens picked colors by one step
// (#FF0000 would read as #FE0000). X11 input doesn't depend on opacity.
export component PickerShieldWindow inherits Window {
    width: 1px;
    height: 1px;
    full-screen: true;
    no-frame: true;
    always-on-top: true;
    background: #00000000;
    title: "Archtoys Picker Shield";

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000000;
        TouchArea { }
    }
}

// --- Freeze-frame picker: one window per monitor, each showing its part of
// the screenshot; you pick from it ---
// No fixed width/height here: `width: 1px` would shrink the *contents* to
// one pixel even though the window itself is fullscreen.
// A word Text Extractor found, in the capture window's own coordinates.
export struct TextBox {
    x: length,
    y: length,
    w: length,
    h: length,
}

// A button on the capture toolbar (always dark: it sits on the screenshot).
component CaptureButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 38px;
    width: label.preferred-width + 30px;
    border-radius: 10px;
    background: root.primary ? (touch.has-hover ? #2a9be0 : #1e8ccf) : (touch.has-hover ? #2c2f37 : #1d1f25);
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: #f2f3f6;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component FreezePickerWindow inherits Window {
    full-screen: true;
    no-frame: true;
    always-on-top: true;
    // see-through until Rust knows which part of the screenshot this monitor
    // shows (the screen looks the same as the screenshot meanwhile)
    background: #00000000;
    title: "Archtoys Picker";

    in-out property <image> screenshot-image;
    in-out property <bool> ready: false;
    // this monitor's part of the screenshot, in screenshot pixels
    in-out property <int> clip-x;
    in-out property <int> clip-y;
    in-out property <int> clip-width;
    in-out property <int> clip-height;
    in-out property <image> magnifier;
    in-out property <color> preview-color: #000000;
    in-out property <string> preview-hex: "";
    in-out property <length> cursor-x: -1000px;
    in-out property <length> cursor-y: -1000px;
    // the arrow keys moved the pick point (the mouse pointer stays where it is)
    in-out property <bool> marker: false;
    // --- Text Extractor's capture (v0.7.0): drag a rectangle over text ---
    in property <bool> text-mode: false;
    // reading the text (Tesseract is running)
    in property <bool> busy: false;
    in property <string> busy-text: "Reading…";
    // the words found, outlined
    in property <[TextBox]> words;
    // the toolbar under the selection
    in property <bool> tools: false;
    // "English · 98% sure"
    in property <string> tools-info;
    // the selection, in this window's logical pixels
    in-out property <length> sel-x;
    in-out property <length> sel-y;
    in-out property <length> sel-w;
    in-out property <length> sel-h;
    in-out property <bool> has-selection: false;
    property <bool> selecting: false;
    // Enter was pressed before the text was read: copy as soon as it is
    property <bool> copy-when-read: false;
    changed tools => {
        if root.tools && root.copy-when-read {
            root.copy-when-read = false;
            root.tool("copy");
        }
    }
    callback region-started();
    callback region-done(length, length, length, length);
    // "copy", "line" (as one line), "open" (in the app)
    callback tool(string);

    // where the mouse is over this window, read once the windows are laid out
    out property <bool> hovered: area.has-hover;
    out property <length> hover-x: area.mouse-x;
    out property <length> hover-y: area.mouse-y;

    // logical pixel coordinates inside this window
    callback pointer-moved(length, length);
    callback pick-at(length, length);
    callback cancel-pick();
    // arrow keys: one pixel; Enter picks the point
    callback nudge(int, int);
    callback pick-point();

    Image {
        width: parent.width;
        height: parent.height;
        visible: root.ready;
        source: root.screenshot-image;
        source-clip-x: root.clip-x;
        source-clip-y: root.clip-y;
        source-clip-width: root.clip-width;
        source-clip-height: root.clip-height;
        image-fit: fill;
    }

    area := TouchArea {
        mouse-cursor: crosshair;
        // text capture: where the drag started, and the mouse's last place
        property <length> anchor-x;
        property <length> anchor-y;
        property <length> last-x;
        property <length> last-y;
        // `moved` only fires while a button is held, so watch the position.
        changed mouse-x => {
            if !root.text-mode {
                root.pointer-moved(self.mouse-x, self.mouse-y);
            }
        }
        changed mouse-y => {
            if !root.text-mode {
                root.pointer-moved(self.mouse-x, self.mouse-y);
            }
        }
        clicked => {
            if !root.text-mode {
                root.pick-at(self.mouse-x, self.mouse-y);
            }
        }
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.cancel-pick();
            }
            if root.text-mode && event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                self.anchor-x = self.mouse-x;
                self.anchor-y = self.mouse-y;
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
                root.sel-x = self.mouse-x;
                root.sel-y = self.mouse-y;
                root.sel-w = 0px;
                root.sel-h = 0px;
                root.selecting = true;
                root.has-selection = false;
                root.copy-when-read = false;
                root.region-started();
            }
            // Shift held while dragging moves the rectangle instead of resizing it
            if root.text-mode && root.selecting && event.kind == PointerEventKind.move {
                if event.modifiers.shift {
                    root.sel-x += self.mouse-x - self.last-x;
                    root.sel-y += self.mouse-y - self.last-y;
                    self.anchor-x += self.mouse-x - self.last-x;
                    self.anchor-y += self.mouse-y - self.last-y;
                } else {
                    root.sel-x = Math.min(self.anchor-x, self.mouse-x);
                    root.sel-y = Math.min(self.anchor-y, self.mouse-y);
                    root.sel-w = Math.abs(self.mouse-x - self.anchor-x);
                    root.sel-h = Math.abs(self.mouse-y - self.anchor-y);
                }
                self.last-x = self.mouse-x;
                self.last-y = self.mouse-y;
            }
            if root.text-mode && root.selecting && event.button == PointerEventButton.left && event.kind == PointerEventKind.up {
                root.selecting = false;
                if root.sel-w >= 4px && root.sel-h >= 4px {
                    root.has-selection = true;
                    root.region-done(root.sel-x, root.sel-y, root.sel-w, root.sel-h);
                }
            }
        }
    }

    // the arrow keys moved the selection: read it again once they rest
    nudge-timer := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.region-done(root.sel-x, root.sel-y, root.sel-w, root.sel-h);
        }
    }
    function move-selection(dx: length, dy: length) {
        if root.has-selection {
            root.sel-x += dx;
            root.sel-y += dy;
            root.region-started();
            nudge-timer.running = true;
            nudge-timer.restart();
        }
    }

    FocusScope {
        enabled: true;
        init => { self.focus(); }
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-pick();
                return accept;
            }
            if root.text-mode {
                if event.text == Key.LeftArrow {
                    root.move-selection(-1px, 0px);
                    return accept;
                }
                if event.text == Key.RightArrow {
                    root.move-selection(1px, 0px);
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.move-selection(0px, -1px);
                    return accept;
                }
                if event.text == Key.DownArrow {
                    root.move-selection(0px, 1px);
                    return accept;
                }
                // Enter copies: at once when the text is read, else as soon as it
                // is (also in the middle of a drag: that ends the selection)
                if event.text == Key.Return {
                    if root.tools && !root.busy {
                        root.tool("copy");
                    } else if root.selecting && root.sel-w >= 4px && root.sel-h >= 4px {
                        root.selecting = false;
                        root.has-selection = true;
                        root.copy-when-read = true;
                        root.region-done(root.sel-x, root.sel-y, root.sel-w, root.sel-h);
                    } else if root.has-selection {
                        root.copy-when-read = true;
                    }
                    return accept;
                }
                return reject;
            }
            if event.text == Key.LeftArrow {
                root.nudge(-1, 0);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.nudge(1, 0);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.nudge(0, -1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.nudge(0, 1);
                return accept;
            }
            if event.text == Key.Return {
                root.pick-point();
                return accept;
            }
            reject
        }
    }

    // --- text capture: dim the rest, outline the selection and the words ---
    if root.text-mode && root.ready : text-overlay := Rectangle {
        property <bool> shown: root.selecting || root.has-selection;
        property <color> dim: #00000066;
        // nothing selected yet: the whole screen a little darker
        if !text-overlay.shown : Rectangle { background: #00000040; }
        if text-overlay.shown : Rectangle { x: 0; y: 0; width: root.width; height: root.sel-y; background: text-overlay.dim; }
        if text-overlay.shown : Rectangle { x: 0; y: root.sel-y + root.sel-h; width: root.width; height: root.height - root.sel-y - root.sel-h; background: text-overlay.dim; }
        if text-overlay.shown : Rectangle { x: 0; y: root.sel-y; width: root.sel-x; height: root.sel-h; background: text-overlay.dim; }
        if text-overlay.shown : Rectangle { x: root.sel-x + root.sel-w; y: root.sel-y; width: root.width - root.sel-x - root.sel-w; height: root.sel-h; background: text-overlay.dim; }

        for word in root.words : Rectangle {
            x: word.x;
            y: word.y;
            width: word.w;
            height: word.h;
            border-radius: 2px;
            border-width: 1px;
            border-color: #1e8ccfe6;
            background: #1e8ccf24;
        }

        if text-overlay.shown : Rectangle {
            x: root.sel-x - 2px;
            y: root.sel-y - 2px;
            width: root.sel-w + 4px;
            height: root.sel-h + 4px;
            border-radius: 4px;
            border-width: 2px;
            border-color: #1e8ccf;
        }
        // the selection's size
        if text-overlay.shown && root.sel-w > 60px : Rectangle {
            x: root.sel-x + root.sel-w - self.width;
            y: root.sel-y - self.height - 6px < 0 ? root.sel-y + 6px : root.sel-y - self.height - 6px;
            width: size-text.preferred-width + 12px;
            height: 22px;
            border-radius: 7px;
            background: #1e8ccf;
            size-text := Text {
                text: Math.round(root.sel-w / 1px) + " × " + Math.round(root.sel-h / 1px);
                color: #ffffff;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // under the selection, or above it near the bottom of the screen
        property <length> bar-y: root.sel-y + root.sel-h + 10px + 52px > root.height ? root.sel-y - 10px - 52px : root.sel-y + root.sel-h + 10px;
        if root.has-selection && root.busy : Rectangle {
            x: Math.max(8px, Math.min(root.sel-x, root.width - self.width - 8px));
            y: text-overlay.bar-y;
            width: busy-label.preferred-width + 32px;
            height: 42px;
            border-radius: 12px;
            background: #1d1f25;
            border-width: 1px;
            border-color: #2c2f37;
            busy-label := Text {
                text: root.busy-text;
                color: #f2f3f6;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.has-selection && root.tools && !root.busy : Rectangle {
            x: Math.max(8px, Math.min(root.sel-x, root.width - self.width - 8px));
            y: text-overlay.bar-y;
            width: bar.preferred-width;
            height: 52px;
            border-radius: 14px;
            background: #1d1f25;
            border-width: 1px;
            border-color: #2c2f37;
            bar := HorizontalLayout {
                padding: 7px;
                padding-right: 14px;
                spacing: 7px;
                CaptureButton { text: "Copy"; primary: true; clicked => { root.tool("copy"); } }
                CaptureButton { text: "Copy as one line"; clicked => { root.tool("line"); } }
                CaptureButton { text: "Open"; clicked => { root.tool("open"); } }
                Text {
                    text: root.tools-info;
                    color: #a3a7b3;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
        }
        if !root.selecting && !root.has-selection : Rectangle {
            x: (root.width - self.width) / 2;
            y: root.height - self.height - 40px;
            width: hint.preferred-width + 36px;
            height: 42px;
            border-radius: 21px;
            background: #111216d9;
            hint := Text {
                text: "Drag over the text · Shift moves the box · Esc cancels";
                color: #f2f3f6;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    // the pixel the arrow keys moved to
    if root.marker && !root.text-mode : Rectangle {
        x: root.cursor-x - 7px;
        y: root.cursor-y - 7px;
        width: 14px;
        height: 14px;
        border-width: 1px;
        border-color: #ffffff;
        Rectangle {
            x: 1px;
            y: 1px;
            width: 12px;
            height: 12px;
            border-width: 1px;
            border-color: #000000;
        }
    }

    if root.preview-hex != "" && !root.text-mode : PreviewCard {
        magnifier: root.magnifier;
        preview-color: root.preview-color;
        preview-hex: root.preview-hex;
        // beside the cursor; flips to the other side near the screen edges
        // on whole pixels (the cursor is a pixel's centre), else OpenGL blurs it
        property <length> cx: Math.floor(root.cursor-x / 1phx) * 1phx;
        property <length> cy: Math.floor(root.cursor-y / 1phx) * 1phx;
        x: self.cx + 20px + self.width > root.width ? self.cx - 20px - self.width : self.cx + 20px;
        y: self.cy + 20px + self.height > root.height ? self.cy - 20px - self.height : self.cy + 20px;
    }
}

export component AppWindow inherits Window {
    title: "Archtoys";
    // During a freeze-frame pick with "Minimize on Pick" off, the window
    // stays open above the screenshot (X11 needs always-on-top for that).
    always-on-top: root.keep-on-top;
    // Used on X11. On Wayland the desktop takes the icon from archtoys.desktop.
    icon: @image-url("../packaging/archtoys-256.png");
    preferred-width: 520px;
    // the card, two rows of boxes and the shades; more boxes scroll
    preferred-height: 560px;
    // the pinned sidebar adds its width (Rust sets the same limits on the window)
    min-width: 480px + root.pinned-w;
    min-height: 420px;
    max-width: 900px + root.pinned-w;
    max-height: 1000px;
    background: Skin.bg-color;

    // --- The frame (v0.7.0): pages, the sidebar, the bar with the menu ---
    // 0 Home, 1 Color Picker, 2 Text Extractor (a first start opens Home)
    in-out property <int> page: 0;
    // the sidebar kept open: 0 no, 1 its icons (click the menu button), 2 all
    // of it (double-click it)
    in-out property <int> sidebar-mode: 0;
    // opened over the toy by resting on the menu button
    property <bool> sidebar-shown: false;
    property <length> title-h: 40px;
    property <length> side-w: 178px;
    property <length> rail-w: 60px;
    // the room the pinned sidebar takes beside the toy (window.rs has the same widths)
    property <length> pinned-w: root.sidebar-mode == 2 ? root.side-w : root.sidebar-mode == 1 ? root.rail-w : 0px;
    property <length> toy-x: root.pinned-w;
    // when the menu button was last clicked: a second click soon after pins all of it
    property <duration> menu-clicked-at: -1s;
    property <length> toy-y: root.title-h;
    property <length> toy-w: root.width - root.toy-x;
    property <length> toy-h: root.height - root.toy-y;
    // the Color Picker's header starts this far below the bar
    property <length> picker-top: 6px;
    // which settings to show: the page they were opened from (0 Home: all)
    property <int> settings-scope: 1;
    property <bool> about-open: false;
    callback sidebar-mode-changed(int, int);
    // the bar at the top is being dragged
    callback window-move();
    callback page-changed(int);
    callback open-licenses();
    callback open-link(string);
    in property <string> app-version;

    // --- Text Extractor ---
    // 0 off, 1 installing, 2 ready, 3 can't be installed here
    in property <int> text-state;
    in property <string> text-distro;
    in property <string> text-installed-version;
    in property <float> text-install-fraction: -1;
    in property <string> text-install-stats;
    in property <string> text-install-stage;
    in property <string> text-message;
    in property <[TextEntry]> text-history;
    in-out property <int> text-detail: -1;
    in-out property <string> setting-text-hotkey: "Ctrl+Super+T";
    in-out property <string> text-hotkey-display: "";
    in-out property <bool> setting-text-tools: true;
    in-out property <bool> setting-text-stay-minimized: false;
    in-out property <bool> setting-text-keep-lines: true;
    // "English, Arabic · 5.5 MB"
    in property <string> text-languages-info;
    // "Tesseract 5.3.4"
    in property <string> text-engine-info;
    // a newer Tesseract: 0 checking, 1 up to date, 2 available, 3 couldn't tell
    in property <int> text-update: 0;
    // which hotkey the recorder records: 0 the Color Picker's, 1 Text Extractor's
    in-out property <int> hotkey-target: 0;
    callback text-turn-on();
    callback text-cancel-install();
    callback text-check-again();
    callback text-extract();
    callback text-copy(string);
    callback text-delete(int);
    callback text-clear();
    callback text-delete-languages();
    // Start with the keyboard on the window itself, so Ctrl+F works at once.
    forward-focus: defocus-scope;

    // the selected color (or the search result under the mouse)
    in property <color> current-color: #cbb6ac;
    in property <[color]> history-model: [#e0e0e0, #4a5a6a, #cbb6ac, #8c8b5c];
    // the first format, shown big on the color card
    in property <FieldRow> card;
    in property <string> card-name;
    in property <color> card-ink: #ffffff;
    // the other formats, as boxes
    in property <[FieldRow]> fields;
    in property <[ShadeCell]> shades;
    in property <[FormatOption]> format-options;

    // --- The color editor (the pen on the middle shade) ---
    in-out property <bool> editor-open: false;
    in-out property <bool> setting-editor-compare: false;
    in-out property <bool> setting-editor-cancel-forgets: true;
    in-out property <bool> setting-editor-keep: false;
    in-out property <bool> setting-editor-reset: true;
    // the edited color (the whole card while Compare is off)
    in property <color> editor-color: #808080;
    in property <color> editor-ink: #ffffff;
    in property <string> editor-name;
    in property <string> editor-value;
    // the second color (the right half while Compare is on)
    in property <color> editor-compare-color: #808080;
    in property <color> editor-compare-ink: #ffffff;
    in property <string> editor-compare-name;
    in property <string> editor-compare-value;
    in property <string> editor-ratio;
    // the color the square, the hue slider and the fields work on
    in property <float> editor-h;
    in property <float> editor-s;
    in property <float> editor-v;
    in property <color> editor-hue-color: #ff0000;
    in property <color> editor-use-color: #808080;
    in property <color> editor-use-ink: #ffffff;
    in property <string> editor-use-label: "Use";
    // the first two formats (one when only one is on)
    in property <[FieldRow]> editor-fields;
    callback editor-open-requested();
    callback editor-close();
    callback editor-cancel();
    callback editor-use();
    callback editor-sv(float, float);
    callback editor-hue(float);
    callback editor-field-edited(string, string);
    callback editor-field-accepted(string, string);
    callback editor-copy(string);
    callback editor-compare-toggled();
    callback editor-pick();
    // the panel rises; the right half of the card grows in with Compare on
    property <float> editor-t: root.editor-open ? 1 : 0;
    animate editor-t { duration: 220ms; easing: ease-out; }
    property <float> compare-t: root.editor-open && root.setting-editor-compare ? 1 : 0;
    animate compare-t { duration: 200ms; easing: ease-out; }
    property <length> card-w: root.toy-w - 2 * root.pad;
    // the pen's hint shows after the mouse rests on it for a moment
    property <bool> pen-hover: false;
    property <bool> pen-hint: false;
    changed pen-hover => {
        if !self.pen-hover {
            self.pen-hint = false;
        }
    }
    // a pick for the compare half took the keyboard: give it back to the panel
    changed picking => {
        if !self.picking && self.editor-open {
            editor-keys.focus();
        }
    }
    changed editor-open => {
        if self.editor-open {
            body.viewport-y = 0;
            root.pen-hover = false;
            editor-keys.focus();
        } else {
            defocus-scope.focus();
        }
    }

    property <bool> settings-open: false;
    in-out property <bool> setting-minimize: false;
    in-out property <bool> setting-minimize-tray: true;
    in-out property <bool> setting-autocopy: false;
    in-out property <bool> setting-autostart: false;
    in-out property <bool> setting-card-gradient: false;
    in-out property <bool> setting-show-name: true;
    // the sliders button in the header
    in-out property <bool> setting-formats-button: true;
    in-out property <string> setting-hotkey: "Ctrl+Super+C";
    property <bool> setting-hotkey-recording: false;
    // True when the desktop (e.g. KDE) owns the shortcut; it must be changed
    // in the desktop's settings, and `hotkey-display` shows the real one.
    in-out property <bool> hotkey-system-managed: false;
    in-out property <string> hotkey-display: "";
    // Shown briefly when a typed color can't be understood.
    in-out property <string> input-error: "";
    in-out property <bool> keep-on-top: false;
    property <bool> formats-open: false;
    in-out property <bool> picking: false;

    callback pick-color();
    // copies the shown color in that format, in full: rgb(255, 70, 162)
    callback copy-value(string);
    callback history-clicked(int);
    callback shade-clicked(float);
    callback value-edited(string, string);
    callback value-accepted(string, string);
    callback value-blurred(string, string);
    callback hotkey-captured(string, bool, bool, bool, bool);
    callback settings-changed();
    callback settings-opened();
    callback format-toggled(string, bool);
    callback format-moved(string, int);
    callback cancel-pick();
    callback pick-nudge(int, int);
    callback pick-point();
    callback open-hotkey-settings();
    callback clear-history();
    callback report-problem();

    // --- Color search ---
    property <bool> search-open: false;
    in property <[SearchCard]> search-results;
    // "Showing results for pink", or a hint when nothing matches
    in property <string> search-note;
    // "5,351 colors · 0.84 ms"
    in property <string> search-summary;
    // bumped by the app for every new search (the grid scrolls back to the top)
    in property <int> search-generation;
    // the card under the mouse or chosen with the arrow keys (-1: none)
    property <int> search-highlight: -1;
    // true while the arrow keys move the highlight (then the grid follows it)
    property <bool> search-keyboard: false;
    // 0 = closed, 1 = open; animated: the bar grows, the card slides down,
    // the boxes and shades fade out
    property <float> search-t: root.search-open ? 1 : 0;
    animate search-t { duration: 200ms; easing: ease-out; }
    // light <-> dark fades instead of jumping (see Skin.dark-t)
    property <float> theme-t: Skin.dark-mode ? 1 : 0;
    animate theme-t { duration: root.started ? 200ms : 0ms; easing: ease-in-out; }
    init => { Skin.dark-t = self.theme-t; }
    changed theme-t => { Skin.dark-t = self.theme-t; }
    callback search-changed(string);
    callback search-hovered(int);
    callback search-applied(int);
    callback search-closed();
    callback search-load-more();

    property <length> pad: 18px;
    // 0 = the picker, 1 = settings; animated
    property <float> settings-t: root.settings-open ? 1 : 0;
    animate settings-t { duration: 200ms; easing: ease-out; }
    property <float> formats-t: root.formats-open ? 1 : 0;
    animate formats-t { duration: 160ms; easing: ease-out; }
    // the error message stays readable while it fades out
    property <string> toast-text;
    property <float> toast-t: root.input-error != "" ? 1 : 0;
    animate toast-t { duration: 180ms; easing: ease-out; }
    changed input-error => {
        if root.input-error != "" {
            root.toast-text = root.input-error;
        }
    }
    // the aurora follows the color smoothly
    property <color> aurora: root.current-color;
    animate aurora { duration: root.started ? 500ms : 0ms; easing: ease-in-out; }
    // Colors and the theme only fade once the app is up: at startup the saved
    // theme and color replace the defaults at once, without a flash.
    property <bool> started: false;
    Timer {
        interval: 400ms;
        running: !root.started;
        triggered => { root.started = true; }
    }
    Timer {
        interval: 600ms;
        running: root.pen-hover && !root.pen-hint;
        triggered => { root.pen-hint = true; }
    }

    function open-search() {
        root.formats-open = false;
        root.settings-open = false;
        root.search-open = true;
        root.search-highlight = -1;
        body.viewport-y = 0;
        search-input.text = "";
        root.search-changed("");
        search-input.focus();
    }

    // Ctrl+F opens the search, and closes it when it is open.
    function toggle-search() {
        if root.search-open {
            root.close-search();
        } else {
            root.open-search();
        }
    }

    // Esc, Ctrl+F, a click on the card or elsewhere: the previous color comes back.
    function close-search() {
        if root.search-open {
            root.search-open = false;
            root.search-highlight = -1;
            root.search-closed();
            defocus-scope.focus();
        }
    }

    function apply-search(index: int) {
        if index >= 0 && index < root.search-results.length {
            root.search-applied(index);
            root.close-search();
        }
    }

    // Arrow keys: +-1 moves along a row, +-5 moves a row. Up from the first
    // row goes back to the text.
    function move-highlight(delta: int) {
        if root.search-results.length > 0 {
            root.search-keyboard = true;
            root.search-highlight = root.search-highlight < 0 ? (delta > 0 ? 0 : -1)
                : root.search-highlight + delta < 0 ? (delta == -5 ? -1 : root.search-highlight)
                : Math.min(root.search-highlight + delta, root.search-results.length - 1);
            if root.search-highlight > root.search-results.length - 11 {
                root.search-load-more();
            }
            root.search-hovered(root.search-highlight);
        }
    }

    function open-settings() {
        root.close-search();
        root.formats-open = false;
        if root.editor-open {
            root.editor-close();
        }
        root.settings-scope = root.page;
        root.about-open = false;
        root.settings-open = true;
        root.settings-opened();
        if root.sidebar-mode == 0 {
            root.sidebar-shown = false;
        }
    }

    function close-settings() {
        root.settings-open = false;
        root.about-open = false;
        root.setting-hotkey-recording = false;
        defocus-scope.focus();
    }

    // Goes to a page: closes what belongs to the old one.
    public function go(page: int) {
        root.close-search();
        root.formats-open = false;
        if root.editor-open {
            root.editor-close();
        }
        if root.settings-open {
            root.close-settings();
        }
        root.text-detail = -1;
        root.page = page;
        root.page-changed(page);
        if root.sidebar-mode == 0 {
            root.sidebar-shown = false;
        }
    }

    public function focus-pick-scope() {
        pick-scope.focus();
    }

    // the menu button: closed -> icons; a second click soon after -> all of
    // it; open (either way) -> closed
    function menu-clicked() {
        let old = root.sidebar-mode;
        let quick = animation-tick() - root.menu-clicked-at < 400ms;
        root.sidebar-mode = old == 1 && quick ? 2 : old == 0 ? 1 : 0;
        root.menu-clicked-at = animation-tick();
        root.sidebar-shown = false;
        root.sidebar-mode-changed(old, root.sidebar-mode);
    }

    // rest on the menu button: open; leave it and the sidebar: close
    Timer {
        interval: 400ms;
        running: root.sidebar-mode == 0 && !root.sidebar-shown && title-bar.menu-hovered;
        triggered => { root.sidebar-shown = true; }
    }
    Timer {
        interval: 300ms;
        running: root.sidebar-shown && !title-bar.menu-hovered && !side.hovered;
        triggered => { root.sidebar-shown = false; }
    }

    // --- The window (v0.7.0): the aurora, the toy, the bar with the menu
    // and the sidebar ---
    frame := Rectangle {
        background: Skin.bg-color;
        clip: true;

        // The aurora: a faint glow in the top-right corner, in the selected color
        Rectangle {
            x: root.width - 300px;
            y: -300px;
            width: 600px;
            height: 600px;
            background: @radial-gradient(circle, root.aurora.transparentize(1 - Skin.aurora-strength) 0%, root.aurora.transparentize(1) 50%);
        }

        // the toy (or Home, or Settings), beside the pinned sidebar
        toy-area := Rectangle {
            x: root.toy-x;
            y: root.toy-y;
            width: root.toy-w;
            height: root.toy-h;

            // Esc cancels a pick while this window has the keyboard; the arrow keys
            // move the pick point and Enter picks it (freeze frame).
            pick-scope := FocusScope {
                enabled: root.picking;
                width: 1px;
                height: 1px;
                key-pressed(event) => {
                    if event.text == Key.Escape {
                        root.cancel-pick();
                        return accept;
                    }
                    if event.text == Key.LeftArrow {
                        root.pick-nudge(-1, 0);
                        return accept;
                    }
                    if event.text == Key.RightArrow {
                        root.pick-nudge(1, 0);
                        return accept;
                    }
                    if event.text == Key.UpArrow {
                        root.pick-nudge(0, -1);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.pick-nudge(0, 1);
                        return accept;
                    }
                    if event.text == Key.Return {
                        root.pick-point();
                        return accept;
                    }
                    reject
                }
            }

            hotkey-record-scope := FocusScope {
                enabled: root.setting-hotkey-recording;
                width: 1px;
                height: 1px;
                key-pressed(event) => {
                    if !root.setting-hotkey-recording {
                        return reject;
                    }
                    if event.text == Key.Escape {
                        root.setting-hotkey-recording = false;
                        return accept;
                    }
                    if event.text == Key.Control || event.text == Key.ControlR
                        || event.text == Key.Shift || event.text == Key.ShiftR
                        || event.text == Key.Alt || event.text == Key.AltGr
                        || event.text == Key.Meta || event.text == Key.MetaR {
                        return accept;
                    }
                    if !event.modifiers.control
                        && !event.modifiers.alt
                        && !event.modifiers.shift
                        && !event.modifiers.meta {
                        return accept;
                    }
                    root.hotkey-captured(
                        event.text,
                        event.modifiers.control,
                        event.modifiers.alt,
                        event.modifiers.shift,
                        event.modifiers.meta
                    );
                    root.setting-hotkey-recording = false;
                    return accept;
                }
            }

            // A click on nothing in particular: leave the text field, close the search.
            TouchArea {
                clicked => {
                    root.close-search();
                    defocus-scope.focus();
                }
            }

            // Holds the focus when nothing else should. It wraps the window's content,
            // so Ctrl+F works from anywhere, including while typing in a box.
            defocus-scope := FocusScope {
                key-pressed(event) => {
                    if root.page == 1 && !root.settings-open && event.modifiers.control && (event.text == "f" || event.text == "F") {
                        root.toggle-search();
                        return accept;
                    }
                    if event.text == Key.Escape && root.formats-open {
                        root.formats-open = false;
                        return accept;
                    }
                    if event.text == Key.Escape && root.settings-open {
                        root.close-settings();
                        return accept;
                    }
                    reject
                }

                // --- The Color Picker ---
                Rectangle {
                  visible: root.page == 1 && root.settings-t < 0.99;
                  opacity: 1 - root.settings-t;
                  VerticalLayout {
                    padding-top: root.picker-top;
                    spacing: 14px;

                    // Header: Pick, history, search, formats
                    HorizontalLayout {
                        height: 40px;
                        padding-left: root.pad;
                        padding-right: root.pad;
                        spacing: 6px;

                        pick-button := ActionButton {
                            icon: @image-url("pick.svg");
                            text: "Pick";
                            label: "Pick a color from the screen";
                            clicked => { root.pick-color(); }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;
                            // fades out under the search bar, so no dot peeks out
                            opacity: 1 - root.search-t;
                            Flickable {
                                x: 10px;
                                width: parent.width - 10px;
                                viewport-width: root.history-model.length * 32px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    for col[i] in root.history-model : VerticalLayout {
                                        alignment: center;
                                        ColorBubble {
                                            bubble-color: col;
                                            clicked => { root.history-clicked(i); }
                                        }
                                    }
                                }
                            }
                        }

                        search-button := HeaderButton {
                            icon: @image-url("search.svg");
                            label: "Search colors (Ctrl+F)";
                            y: 2px;
                            clicked => { root.open-search(); }
                        }

                        if root.setting-formats-button : HeaderButton {
                            icon: @image-url("sliders.svg");
                            label: "Customize formats";
                            active: root.formats-open;
                            y: 2px;
                            clicked => {
                                root.close-search();
                                root.formats-open = !root.formats-open;
                            }
                        }

                    }

                    Rectangle {
                        vertical-stretch: 1;

                        // --- The picker: the color card, the format boxes, the shades.
                        // While searching, the card slides to the bottom and the
                        // results open above it.
                        body := ScrollView {
                            opacity: 1 - root.settings-t;
                            visible: root.settings-t < 0.99;
                            property <length> card-h: 150px;
                            property <length> box-h: 54px;
                            property <length> box-gap: 10px;
                            property <length> inner-w: self.visible-width - 2 * root.pad;
                            property <int> box-rows: Math.ceil(root.fields.length / 2);
                            property <length> boxes-y: self.card-h + 14px;
                            property <length> shades-y: self.boxes-y + (self.box-rows == 0 ? 0px : self.box-rows * (self.box-h + self.box-gap) + 8px);
                            property <length> content-h: self.shades-y + 24px + 92px + root.pad;
                            viewport-width: self.visible-width;
                            viewport-height: root.search-open ? self.visible-height : Math.max(self.content-h, self.visible-height);

                            // the search results, above the card
                            if root.search-t > 0.01 : Rectangle {
                                x: root.pad;
                                y: 0;
                                width: body.inner-w;
                                height: body.visible-height - body.card-h - root.pad - 16px;
                                opacity: root.search-t;

                                TouchArea { } // clicks between the cards don't close it

                                VerticalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: root.search-results.length == 0
                                            ? (root.search-note != "" ? root.search-note : "Type a color name, a word like sky, or a code like #FF46A2")
                                            : (root.search-note != "" ? root.search-note : "Results") + " · " + root.search-summary;
                                        color: Skin.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }

                                    grid := Flickable {
                                        vertical-stretch: 1;
                                        property <length> gap: 8px;
                                        property <length> edge: 4px; // room for the highlight outline
                                        property <length> card-w: (self.width - 2 * self.edge - 4 * self.gap) / 5;
                                        property <length> card-h: self.card-w * 0.9;
                                        property <int> generation: root.search-generation;
                                        property <int> highlight: root.search-highlight;
                                        viewport-height: Math.ceil(root.search-results.length / 5) * (self.card-h + self.gap) + 2 * self.edge;

                                        changed generation => { self.viewport-y = 0; }
                                        changed viewport-y => {
                                            if -self.viewport-y + self.height > self.viewport-height - 2 * (self.card-h + self.gap) {
                                                root.search-load-more();
                                            }
                                        }
                                        // The arrow keys move the highlight: keep it in view.
                                        changed highlight => {
                                            if root.search-keyboard && self.highlight >= 0 {
                                                if self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) < -self.viewport-y {
                                                    self.viewport-y = -Math.floor(self.highlight / 5) * (self.card-h + self.gap);
                                                } else if self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) + self.card-h + self.edge > -self.viewport-y + self.height {
                                                    self.viewport-y = -(2 * self.edge + Math.floor(self.highlight / 5) * (self.card-h + self.gap) + self.card-h - self.height);
                                                }
                                            }
                                        }

                                        for result[i] in root.search-results : SearchCardView {
                                            x: grid.edge + Math.mod(i, 5) * (grid.card-w + grid.gap);
                                            y: grid.edge + Math.floor(i / 5) * (grid.card-h + grid.gap);
                                            width: grid.card-w;
                                            height: grid.card-h;
                                            card: result;
                                            highlighted: root.search-highlight == i;
                                            hover-changed(on) => {
                                                root.search-keyboard = false;
                                                if on {
                                                    root.search-highlight = i;
                                                    root.search-hovered(i);
                                                } else if root.search-highlight == i {
                                                    root.search-highlight = -1;
                                                    root.search-hovered(-1);
                                                }
                                            }
                                            clicked => { root.apply-search(i); }
                                        }

                                        // The highlighted card's full name, drawn over its neighbours.
                                        if root.search-highlight >= 0 && root.search-highlight < root.search-results.length : Rectangle {
                                            property <length> card-x: grid.edge + Math.mod(root.search-highlight, 5) * (grid.card-w + grid.gap);
                                            width: Math.min(grid.width - 2 * grid.edge, Math.max(grid.card-w - 8px, full-name.preferred-width + 16px));
                                            height: 22px;
                                            x: Math.max(grid.edge, Math.min(self.card-x + (grid.card-w - self.width) / 2, grid.width - grid.edge - self.width));
                                            y: grid.edge + Math.floor(root.search-highlight / 5) * (grid.card-h + grid.gap) + grid.card-h - self.height - 5px;
                                            border-radius: 11px;
                                            background: #1b1c20;
                                            full-name := Text {
                                                x: 8px;
                                                width: parent.width - 16px;
                                                height: parent.height;
                                                text: root.search-results[root.search-highlight].name;
                                                color: #ffffff;
                                                font-size: 11px;
                                                overflow: elide;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // formats 2..n, two per row
                            for row[i] in root.fields : FormatBox {
                                x: root.pad + Math.mod(i, 2) * (self.width + body.box-gap);
                                y: body.boxes-y + Math.floor(i / 2) * (body.box-h + body.box-gap);
                                width: (body.inner-w - body.box-gap) / 2;
                                opacity: 1 - root.search-t;
                                visible: root.search-t < 0.99;
                                label: row.label;
                                value: row.value;
                                rev: row.rev;
                                copy => { root.copy-value(row.key); }
                                edited(text) => { root.value-edited(row.key, text); }
                                accepted(text) => { root.value-accepted(row.key, text); }
                                blurred(text) => { root.value-blurred(row.key, text); }
                            }

                            SectionLabel {
                                x: root.pad;
                                y: body.shades-y;
                                opacity: 1 - root.search-t;
                                visible: root.search-t < 0.99;
                                text: "SHADES";
                            }
                            Rectangle {
                                x: root.pad;
                                y: body.shades-y + 24px;
                                width: body.inner-w;
                                height: 92px;
                                border-radius: 16px;
                                clip: true;
                                opacity: 1 - root.search-t;
                                visible: root.search-t < 0.99;
                                for cell[i] in root.shades : ShadeTile {
                                    animated: root.started;
                                    left-radius: i == 0 ? 16px : 0px;
                                    right-radius: i == root.shades.length - 1 ? 16px : 0px;
                                    // edges on whole pixels, so neighbours meet exactly: on
                                    // half pixels the CPU drawing could leave a dark 1px gap
                                    // (and OpenGL a faint seam)
                                    x: Math.round(i * parent.width / 5 / 1phx) * 1phx;
                                    width: Math.round((i + 1) * parent.width / 5 / 1phx) * 1phx - self.x;
                                    height: parent.height;
                                    cell: cell;
                                    label: root.card.label;
                                    clicked => { root.shade-clicked(cell.factor); }
                                    edit => { root.editor-open-requested(); }
                                    pen-hover(on) => { root.pen-hover = on; }
                                }
                            }
                            if root.pen-hint && root.search-t < 0.01 : Rectangle {
                                x: root.pad + body.inner-w / 2 - self.width / 2;
                                y: body.shades-y + 24px - self.height - 6px;
                                width: hint-text.preferred-width + 24px;
                                height: 28px;
                                border-radius: 10px;
                                background: #2c2f37;
                                hint-text := Text {
                                    width: parent.width;
                                    height: parent.height;
                                    text: "Edit or compare this color";
                                    color: #f2f3f6;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            ColorCard {
                                animated: root.started;
                                x: root.pad;
                                y: root.search-t * (body.visible-height - body.card-h - root.pad);
                                width: body.inner-w;
                                height: body.card-h;
                                card-color: root.current-color;
                                ink: root.card-ink;
                                name: root.card-name;
                                label: root.card.label;
                                value: root.card.value;
                                rev: root.card.rev;
                                gradient: root.setting-card-gradient;
                                closes: root.search-open;
                                close => { root.close-search(); }
                                copy => { root.copy-value(root.card.key); }
                                edited(text) => { root.value-edited(root.card.key, text); }
                                accepted(text) => { root.value-accepted(root.card.key, text); }
                                blurred(text) => { root.value-blurred(root.card.key, text); }
                            }
                        }
                    }
                  }
                }

                // --- Home ---
                if root.page == 0 && root.settings-t < 0.99 : HomePage {
                    opacity: 1 - root.settings-t;
                    picker-hotkey: root.hotkey-system-managed ? root.hotkey-display : root.setting-hotkey;
                    text-hotkey: root.hotkey-system-managed ? root.text-hotkey-display : root.setting-text-hotkey;
                    last-color: root.current-color;
                    last-color-value: root.card.value;
                    last-color-name: root.card-name;
                    last-text: root.text-history.length > 0 ? root.text-history[0].preview : "";
                    last-text-detail: root.text-history.length > 0 ? root.text-history[0].language + " · " + root.text-history[0].when : "";
                    open-toy(i) => { root.go(i); }
                }

                // --- Text Extractor ---
                if root.page == 2 && root.settings-t < 0.99 : TextExtractorPage {
                    opacity: 1 - root.settings-t;
                    state: root.text-state;
                    distro: root.text-distro;
                    installed-version: root.text-installed-version;
                    install-fraction: root.text-install-fraction;
                    install-stats: root.text-install-stats;
                    install-stage: root.text-install-stage;
                    message: root.text-message;
                    hotkey: root.hotkey-system-managed ? root.text-hotkey-display : root.setting-text-hotkey;
                    history: root.text-history;
                    detail <=> root.text-detail;
                    turn-on => { root.text-turn-on(); }
                    cancel-install => { root.text-cancel-install(); }
                    check-again => { root.text-check-again(); }
                    extract => { root.text-extract(); }
                    copy-text(t) => { root.text-copy(t); }
                    delete-entry(i) => { root.text-delete(i); }
                    clear-history => { root.text-clear(); }
                }

                // --- Settings: the App's and those of the toy they were opened from
                // (opened from Home: every toy's) ---
                if root.settings-t > 0.01 : settings-scroll := ScrollView {
                    x: (1 - root.settings-t) * 24px;
                    opacity: root.settings-t;
                    viewport-width: self.visible-width;
                    viewport-height: settings-list.preferred-height;

                    settings-list := VerticalLayout {
                        width: parent.visible-width;
                        padding-left: root.pad;
                        padding-right: root.pad;
                        padding-top: root.picker-top;
                        padding-bottom: root.pad;
                        spacing: 10px;

                        HorizontalLayout {
                            spacing: 6px;
                            HeaderButton {
                                icon: @image-url("chevron-left.svg");
                                label: "Back";
                                clicked => {
                                    if root.about-open {
                                        root.about-open = false;
                                        settings-scroll.viewport-y = 0;
                                    } else {
                                        root.close-settings();
                                    }
                                }
                            }
                            Text {
                                text: root.about-open ? "About Archtoys" : "Settings";
                                color: Skin.text-main;
                                font-size: 22px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        if !root.about-open && root.settings-scope != 2 : VerticalLayout {
                            spacing: 10px;
                            SectionLabel { text: "COLOR PICKER"; }

                            SettingCard {
                                title: "Hotkey";
                                subtitle: root.hotkey-system-managed ? "Your desktop manages it. Click to change it in System Settings."
                                    : root.setting-hotkey-recording && root.hotkey-target == 0 ? "Press the new keys, or Esc to cancel"
                                    : "Click to record a new one";
                                PillButton {
                                    text: root.hotkey-system-managed ? (root.hotkey-display == "" ? "Not set" : root.hotkey-display)
                                        : root.setting-hotkey-recording && root.hotkey-target == 0 ? "Press keys…" : root.setting-hotkey;
                                    highlighted: root.setting-hotkey-recording && root.hotkey-target == 0;
                                    clicked => {
                                        if root.hotkey-system-managed {
                                            root.open-hotkey-settings();
                                        } else {
                                            root.hotkey-target = 0;
                                            root.setting-hotkey-recording = true;
                                            hotkey-record-scope.focus();
                                        }
                                    }
                                }
                            }
                            SettingCard {
                                title: "Auto copy";
                                subtitle: "Copy the first format as soon as you pick";
                                Switch {
                                    label: "Auto copy";
                                    checked: root.setting-autocopy;
                                    toggled(on) => { root.setting-autocopy = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Minimize on pick";
                                subtitle: "Hide the window while you pick";
                                Switch {
                                    label: "Minimize on pick";
                                    checked: root.setting-minimize;
                                    toggled(on) => { root.setting-minimize = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Show color name";
                                subtitle: "On the color card and the shades";
                                Switch {
                                    label: "Show color name";
                                    checked: root.setting-show-name;
                                    toggled(on) => { root.setting-show-name = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Color card style";
                                subtitle: "Solid shows the exact color. Gradient adds a sheen.";
                                Segmented {
                                    options: ["Solid", "Gradient"];
                                    selected: root.setting-card-gradient ? 1 : 0;
                                    picked(i) => { root.setting-card-gradient = i == 1; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Formats button";
                                subtitle: "Show the formats button in the header";
                                Switch {
                                    label: "Formats button";
                                    checked: root.setting-formats-button;
                                    toggled(on) => { root.setting-formats-button = on; root.settings-changed(); }
                                }
                            }
                            if !root.setting-formats-button : SettingCard {
                                title: "Formats";
                                subtitle: "Choose the formats and their order";
                                PillButton {
                                    text: "Customize";
                                    clicked => { root.formats-open = true; }
                                }
                            }
                            SettingCard {
                                title: "History";
                                subtitle: "The last 500 colors. Clear keeps only the current one.";
                                PillButton {
                                    text: "Clear";
                                    clicked => { root.clear-history(); }
                                }
                            }

                            SectionLabel { text: "COLOR EDITOR"; }

                            SettingCard {
                                title: "Cancel forgets the edit";
                                subtitle: "Off: Cancel keeps it, like clicking outside";
                                Switch {
                                    label: "Cancel forgets the edit";
                                    checked: root.setting-editor-cancel-forgets;
                                    toggled(on) => { root.setting-editor-cancel-forgets = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Keep the edit after a restart";
                                subtitle: "Reopen the editor where you left it";
                                Switch {
                                    label: "Keep the edit after a restart";
                                    checked: root.setting-editor-keep;
                                    toggled(on) => { root.setting-editor-keep = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Start fresh when the color changes";
                                subtitle: "A new pick, a history color or a search result resets the edit";
                                Switch {
                                    label: "Start fresh when the color changes";
                                    checked: root.setting-editor-reset;
                                    toggled(on) => { root.setting-editor-reset = on; root.settings-changed(); }
                                }
                            }
                        }

                        if !root.about-open && root.settings-scope != 1 : VerticalLayout {
                            spacing: 10px;
                            SectionLabel { text: "TEXT EXTRACTOR"; }

                            SettingCard {
                                title: "Hotkey";
                                subtitle: root.hotkey-system-managed ? "Your desktop manages it. Click to change it in System Settings."
                                    : root.setting-hotkey-recording && root.hotkey-target == 1 ? "Press the new keys, or Esc to cancel"
                                    : "Starts a capture from anywhere";
                                PillButton {
                                    text: root.hotkey-system-managed ? (root.text-hotkey-display == "" ? "Not set" : root.text-hotkey-display)
                                        : root.setting-hotkey-recording && root.hotkey-target == 1 ? "Press keys…" : root.setting-text-hotkey;
                                    highlighted: root.setting-hotkey-recording && root.hotkey-target == 1;
                                    clicked => {
                                        if root.hotkey-system-managed {
                                            root.open-hotkey-settings();
                                        } else {
                                            root.hotkey-target = 1;
                                            root.setting-hotkey-recording = true;
                                            hotkey-record-scope.focus();
                                        }
                                    }
                                }
                            }
                            SettingCard {
                                title: "After selecting text";
                                subtitle: root.setting-text-tools ? "Copy, Copy as one line or Open, on the selection (Enter copies)"
                                    : "The text is copied and the capture closes";
                                Segmented {
                                    options: ["Show tools", "Copy and close"];
                                    selected: root.setting-text-tools ? 0 : 1;
                                    picked(i) => { root.setting-text-tools = i == 0; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Stay minimized";
                                subtitle: "Minimize Archtoys for a capture, and keep it minimized afterwards";
                                Switch {
                                    label: "Stay minimized";
                                    checked: root.setting-text-stay-minimized;
                                    toggled(on) => { root.setting-text-stay-minimized = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Line breaks";
                                subtitle: "Keep them for code and lists, join them for paragraphs";
                                Segmented {
                                    options: ["Keep", "Join"];
                                    selected: root.setting-text-keep-lines ? 0 : 1;
                                    picked(i) => { root.setting-text-keep-lines = i == 0; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Engine";
                                subtitle: root.text-state != 2 ? root.text-engine-info
                                    : root.text-engine-info + (root.text-update == 0 ? " · checking for updates…"
                                        : root.text-update == 1 ? " · up to date"
                                        : root.text-update == 2 ? " · an update is available" : "");
                                // installed: "Update" only when there is one (or it couldn't tell)
                                if root.text-state != 2 || root.text-update >= 2 : PillButton {
                                    text: root.text-state == 2 ? "Update" : "Turn on";
                                    highlighted: root.text-state == 2 && root.text-update == 2;
                                    clicked => { root.text-turn-on(); }
                                }
                            }
                            SettingCard {
                                title: "Languages";
                                subtitle: root.text-languages-info;
                                PillButton {
                                    text: "Delete";
                                    clicked => { root.text-delete-languages(); }
                                }
                            }
                            SettingCard {
                                title: "History";
                                subtitle: "Text only, the last 500";
                                PillButton {
                                    text: "Clear";
                                    clicked => { root.text-clear(); }
                                }
                            }
                        }

                        if !root.about-open : VerticalLayout {
                            spacing: 10px;
                            SectionLabel { text: "APP"; }

                            SettingCard {
                                title: "Start on login";
                                subtitle: "Launch Archtoys in the tray";
                                Switch {
                                    label: "Start on login";
                                    checked: root.setting-autostart;
                                    toggled(on) => { root.setting-autostart = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Minimize to tray on close";
                                subtitle: "Keep running in the tray when you close the window";
                                Switch {
                                    label: "Minimize to tray on close";
                                    checked: root.setting-minimize-tray;
                                    toggled(on) => { root.setting-minimize-tray = on; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "Theme";
                                Segmented {
                                    options: ["Light", "Dark", "System"];
                                    selected: Skin.theme;
                                    picked(i) => { Skin.theme = i; root.settings-changed(); }
                                }
                            }
                            SettingCard {
                                title: "About Archtoys";
                                subtitle: "Version, credits and licences";
                                PillButton {
                                    text: "Open";
                                    clicked => {
                                        root.about-open = true;
                                        settings-scroll.viewport-y = 0;
                                    }
                                }
                            }
                            SettingCard {
                                title: "Report a problem";
                                subtitle: "Opens a GitHub issue with the app and system details filled in";
                                PillButton {
                                    text: "Report";
                                    danger: true;
                                    clicked => { root.report-problem(); }
                                }
                            }
                        }

                        // --- About: version, credits, licences ---
                        if root.about-open : VerticalLayout {
                            spacing: 10px;
                            Text {
                                text: "Archtoys " + root.app-version;
                                color: Skin.text-main;
                                font-size: 17px;
                                font-weight: 700;
                            }
                            Text {
                                text: "MIT License © 2026 Mujtaba1i. Inspired by Microsoft PowerToys; not affiliated with or endorsed by Microsoft.";
                                color: Skin.text-muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            SectionLabel { text: "MADE WITH"; }
                            Rectangle {
                                border-radius: 14px;
                                background: Skin.surface;
                                border-width: 1px;
                                border-color: Skin.border;
                                HorizontalLayout {
                                    padding: 12px;
                                    alignment: center;
                                    AboutSlint { }
                                }
                            }
                            SectionLabel { text: "CREDITS"; }
                            SettingCard {
                                title: "Tesseract OCR";
                                subtitle: "Reads the text · Apache-2.0 · installed from your system's packages";
                                PillButton { text: "Website"; clicked => { root.open-link("https://github.com/tesseract-ocr/tesseract"); } }
                            }
                            SettingCard {
                                title: "Tesseract language data";
                                subtitle: "Downloaded when a language is first needed · Apache-2.0";
                                PillButton { text: "Website"; clicked => { root.open-link("https://github.com/tesseract-ocr/tessdata_fast"); } }
                            }
                            SettingCard {
                                title: "whatlang";
                                subtitle: "Tells which language a text is in · MIT";
                                PillButton { text: "Website"; clicked => { root.open-link("https://github.com/greyblake/whatlang-rs"); } }
                            }
                            SettingCard {
                                title: "Color names by David Aerne";
                                subtitle: "The 32,000 color names (meodai/color-names) · MIT";
                                PillButton { text: "Website"; clicked => { root.open-link("https://github.com/meodai/color-names"); } }
                            }
                            SettingCard {
                                title: "Slint";
                                subtitle: "The user interface toolkit · Royalty-free license 2.0";
                                PillButton { text: "Website"; clicked => { root.open-link("https://slint.dev"); } }
                            }
                            SettingCard {
                                title: "Open-source licences";
                                subtitle: "Every library Archtoys is built from, with its licence";
                                PillButton { text: "Show"; clicked => { root.open-licenses(); } }
                            }
                        }
                    }
                }
            } // defocus-scope

            // its glow (CPU drawing), beside it: the bar clips what is inside
            RingGlow {
                visible: !Skin.real-shadows && search-bar.visible;
                x: search-bar.x;
                y: search-bar.y;
                width: search-bar.width;
                height: search-bar.height;
                glow: Skin.accent.transparentize(0.6);
                radius: search-bar.height / 2;
                blur: 6px;
            }
            // The search bar grows out of the search button, over the history row.
            search-bar := Rectangle {
                // from the start of the history row to the end of the search button,
                // whatever the window's width
                property <length> right: search-button.absolute-position.x - root.toy-x + search-button.width;
                // (the history row starts 6px, the header's spacing, after Pick)
                property <length> full: self.right - (pick-button.absolute-position.x - root.toy-x + pick-button.width + 6px);
                visible: root.search-open || root.search-t > 0.01;
                y: pick-button.absolute-position.y - root.toy-y;
                height: pick-button.height;
                width: search-button.width + (self.full - search-button.width) * root.search-t;
                x: self.right - self.width;
                border-radius: self.height / 2;
                background: Skin.surface;
                border-width: 1px;
                border-color: Skin.accent;
                drop-shadow-blur: 6px;
                drop-shadow-color: Skin.real-shadows ? Skin.accent.transparentize(0.6) : transparent;
                clip: true;

                TouchArea { } // clicks on the bar don't close it

                // Full width from the first moment, so typing works while the bar is
                // still growing; the growing bar only reveals it.
                HorizontalLayout {
                    x: 0;
                    width: parent.full;
                    padding-left: 12px;
                    padding-right: 14px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("search.svg");
                            width: 16px;
                            height: 16px;
                            colorize: Skin.text-muted;
                        }
                    }

                    FocusScope {
                        horizontal-stretch: 1;
                        // Before the text field sees them: arrows move through the
                        // grid, Esc closes. Left/Right only once a card is chosen.
                        capture-key-pressed(event) => {
                            if event.text == Key.Escape
                                || (event.modifiers.control && (event.text == "f" || event.text == "F")) {
                                root.close-search();
                                return accept;
                            }
                            if event.text == Key.DownArrow {
                                root.move-highlight(5);
                                return accept;
                            }
                            if event.text == Key.UpArrow {
                                root.move-highlight(-5);
                                return accept;
                            }
                            if root.search-highlight >= 0 && event.text == Key.RightArrow {
                                root.move-highlight(1);
                                return accept;
                            }
                            if root.search-highlight >= 0 && event.text == Key.LeftArrow {
                                root.move-highlight(-1);
                                return accept;
                            }
                            reject
                        }

                        search-input := TextInput {
                            width: 100%;
                            height: 100%;
                            color: Skin.text-main;
                            font-size: 15px;
                            single-line: true;
                            vertical-alignment: center;
                            accessible-label: "Search colors";
                            edited => {
                                root.search-highlight = -1;
                                root.search-changed(self.text);
                            }
                            accepted => {
                                root.apply-search(root.search-highlight >= 0 ? root.search-highlight : 0);
                            }
                        }
                        if search-input.text == "" : Text {
                            width: 100%;
                            height: 100%;
                            text: "Search colors";
                            color: Skin.text-muted;
                            font-size: 15px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // --- The color editor. The card shows the edit live (with Compare: the
            // selected color and the second color on the right half); a panel rises
            // from the bottom. A click on the dimmed rest closes it and keeps the edit.
            Rectangle {
                // visible from the first moment, so its keyboard handler can take focus
                visible: root.editor-open || root.editor-t > 0.01;

                Rectangle {
                    background: #000000;
                    opacity: 0.45 * root.editor-t;
                }
                TouchArea { clicked => { root.editor-close(); } }

                Rectangle {
                    x: root.pad;
                    y: root.picker-top + 40px + 14px;
                    width: root.card-w;
                    height: 150px;
                    border-radius: 22px;
                    clip: true;
                    opacity: root.editor-t;
                    background: root.setting-editor-compare ? root.current-color : root.editor-color;
                    animate background { duration: 200ms; easing: ease-out; }

                    TouchArea { } // a click on the card doesn't close the panel

                    VerticalLayout {
                        x: 0;
                        width: parent.width * (1 - 0.5 * root.compare-t);
                        padding-left: 20px;
                        padding-right: 12px;
                        padding-bottom: 16px;
                        alignment: end;
                        // split: SELECTED, name, value (like the compare half);
                        // whole: name, format, value (like the main card)
                        if root.setting-editor-compare : Text {
                            text: "SELECTED";
                            color: root.card-ink;
                            opacity: 0.75;
                            font-size: 11px;
                            letter-spacing: 1px;
                        }
                        if (root.setting-editor-compare ? root.card-name : root.editor-name) != "" : Text {
                            text: root.setting-editor-compare ? root.card-name : root.editor-name;
                            color: root.setting-editor-compare ? root.card-ink : root.editor-ink;
                            opacity: 0.9;
                            font-size: root.setting-editor-compare ? 13px : 14px;
                            overflow: elide;
                        }
                        if !root.setting-editor-compare : Text {
                            text: root.card.label;
                            color: root.editor-ink;
                            opacity: 0.75;
                            font-size: 11px;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: root.setting-editor-compare ? root.card.value : root.editor-value;
                            color: root.setting-editor-compare ? root.card-ink : root.editor-ink;
                            font-size: root.setting-editor-compare ? 24px : 38px;
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    // the second color: grows in from the right edge, its text fading in
                    right-half := Rectangle {
                        x: parent.width - self.width;
                        width: parent.width / 2 * root.compare-t;
                        visible: root.compare-t > 0.001;
                        background: root.editor-compare-color;
                        // the card's round corners (rounded clipping needs OpenGL)
                        border-top-right-radius: Math.min(22px, self.width / 2);
                        border-bottom-right-radius: Math.min(22px, self.width / 2);
                        clip: true;
                        VerticalLayout {
                            x: parent.width - self.width;
                            width: root.card-w / 2;
                            padding-left: 12px;
                            padding-right: 16px;
                            padding-top: 12px;
                            padding-bottom: 14px;
                            opacity: root.compare-t;
                            HorizontalLayout {
                                alignment: end;
                                Rectangle {
                                    height: 30px;
                                    width: pick-row.preferred-width;
                                    border-radius: 15px;
                                    border-width: 1px;
                                    border-color: root.editor-compare-ink.transparentize(0.65);
                                    background: root.editor-compare-ink.transparentize(pick-touch.has-hover ? 0.78 : 0.88);
                                    accessible-role: button;
                                    accessible-label: "Pick a color to compare";
                                    accessible-action-default => { root.editor-pick(); }
                                    pick-row := HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Image {
                                                source: @image-url("pick.svg");
                                                width: 14px;
                                                height: 14px;
                                                colorize: root.editor-compare-ink;
                                            }
                                        }
                                        Text {
                                            text: "Pick";
                                            color: root.editor-compare-ink;
                                            font-size: 12px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    pick-touch := TouchArea { clicked => { root.editor-pick(); } }
                                }
                            }
                            Rectangle { vertical-stretch: 1; }
                            Text {
                                text: "COMPARE";
                                color: root.editor-compare-ink;
                                opacity: 0.75;
                                font-size: 11px;
                                letter-spacing: 1px;
                                horizontal-alignment: right;
                            }
                            if root.editor-compare-name != "" : Text {
                                text: root.editor-compare-name;
                                color: root.editor-compare-ink;
                                opacity: 0.9;
                                font-size: 13px;
                                overflow: elide;
                                horizontal-alignment: right;
                            }
                            Text {
                                text: root.editor-compare-value;
                                color: root.editor-compare-ink;
                                font-size: 24px;
                                font-weight: 600;
                                overflow: elide;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    // the contrast ratio, on the seam
                    Rectangle {
                        visible: root.compare-t > 0.01;
                        opacity: root.compare-t;
                        x: right-half.x - self.width / 2;
                        y: 12px;
                        width: ratio-text.preferred-width + 24px;
                        height: 26px;
                        border-radius: 13px;
                        background: #141418;
                        ratio-text := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.editor-ratio;
                            color: #f2f3f6;
                            font-size: 13px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // the panel
                Rectangle {
                    property <length> h: Math.min(440px, Math.max(330px, root.toy-h - 198px));
                    x: 0;
                    y: root.toy-h - self.h * root.editor-t;
                    width: root.toy-w;
                    height: self.h;
                    background: Skin.surface;
                    border-top-left-radius: 22px;
                    border-top-right-radius: 22px;
                    border-width: 1px;
                    border-color: Skin.border;
                    drop-shadow-blur: 32px;
                    drop-shadow-offset-y: -12px;
                    drop-shadow-color: Skin.real-shadows ? #00000070 : transparent;
                    RingGlow {
                        width: parent.width;
                        height: parent.height;
                        glow: #00000070;
                        blur: 32px;
                        radius: 22px;
                        offset-y: -12px;
                        cover: Skin.surface;
                        cover-border: Skin.border;
                        cover-border-width: 1px;
                    }

                    TouchArea { } // clicks inside don't close it

                    // Esc: like clicking outside (closes, keeps the edit). Enter: Use.
                    // In a format field the first Enter takes the typed value; the
                    // field then gives the keyboard back here, so the next one is Use.
                    editor-keys := FocusScope {
                        key-pressed(event) => {
                            if event.text == Key.Escape {
                                root.editor-close();
                                return accept;
                            }
                            if event.text == Key.Return {
                                root.editor-use();
                                return accept;
                            }
                            reject
                        }

                        VerticalLayout {
                            padding-left: root.pad;
                            padding-right: root.pad;
                            padding-top: 8px;
                            padding-bottom: root.pad;
                            spacing: 10px;

                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 36px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Skin.border;
                                }
                            }

                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                Text {
                                    text: "Edit color";
                                    color: Skin.text-main;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 32px;
                                        width: compare-row.preferred-width;
                                        border-radius: 9px;
                                        background: root.setting-editor-compare ? root.editor-compare-color : Skin.track;
                                        animate background { duration: 150ms; }
                                        border-width: 1px;
                                        border-color: root.setting-editor-compare ? root.editor-compare-ink.transparentize(0.75) : Skin.border;
                                        accessible-role: checkbox;
                                        accessible-checked: root.setting-editor-compare;
                                        accessible-label: "Compare";
                                        accessible-action-default => { root.editor-compare-toggled(); }
                                        compare-row := HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 14px;
                                            spacing: 7px;
                                            VerticalLayout {
                                                alignment: center;
                                                Image {
                                                    source: @image-url("compare.svg");
                                                    width: 18px;
                                                    height: 18px;
                                                    colorize: root.setting-editor-compare ? root.editor-compare-ink : Skin.text-main;
                                                }
                                            }
                                            Text {
                                                text: "Compare";
                                                color: root.setting-editor-compare ? root.editor-compare-ink : Skin.text-main;
                                                font-size: 13px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                        TouchArea { clicked => { root.editor-compare-toggled(); } }
                                    }
                                }
                                HeaderButton {
                                    icon: @image-url("close.svg");
                                    label: "Close (Esc)";
                                    clicked => { root.editor-close(); }
                                }
                            }

                            // saturation (left to right) and brightness (bottom to top)
                            Rectangle {
                                vertical-stretch: 1;
                                min-height: 90px;
                                border-radius: 12px;
                                background: @linear-gradient(90deg, #ffffff 0%, root.editor-hue-color 100%);
                                accessible-role: slider;
                                accessible-label: "Saturation and brightness";
                                Rectangle {
                                    border-radius: 12px;
                                    background: @linear-gradient(180deg, #00000000 0%, #000000 100%);
                                }
                                // the round corners when drawn on the CPU (it draws gradients
                                // square): the panel's color over the gradient's corners
                                if !Skin.real-shadows : Rectangle {
                                    clip: true;
                                    Rectangle {
                                        x: -6px;
                                        y: -6px;
                                        width: parent.width + 12px;
                                        height: parent.height + 12px;
                                        border-radius: 18px;
                                        border-width: 6px;
                                        border-color: Skin.surface;
                                    }
                                }
                                Rectangle {
                                    x: root.editor-s * parent.width - 9px;
                                    y: (1 - root.editor-v) * parent.height - 9px;
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    border-width: 2px;
                                    border-color: #ffffff;
                                    background: root.editor-use-color;
                                    drop-shadow-blur: 3px;
                                    drop-shadow-color: Skin.real-shadows ? #00000090 : transparent;
                                    RingGlow {
                                        width: parent.width;
                                        height: parent.height;
                                        glow: #00000090;
                                        blur: 3px;
                                        radius: parent.border-radius;
                                        cover: parent.background;
                                        cover-border: parent.border-color;
                                        cover-border-width: parent.border-width;
                                    }
                                }
                                TouchArea {
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.editor-sv(Math.max(0, Math.min(1, self.mouse-x / self.width)), Math.max(0, Math.min(1, 1 - self.mouse-y / self.height)));
                                        }
                                    }
                                    moved => {
                                        root.editor-sv(Math.max(0, Math.min(1, self.mouse-x / self.width)), Math.max(0, Math.min(1, 1 - self.mouse-y / self.height)));
                                    }
                                }
                            }

                            // hue
                            Rectangle {
                                height: 14px;
                                border-radius: 7px;
                                background: @linear-gradient(90deg, #ff0000 0%, #ffff00 16.67%, #00ff00 33.33%, #00ffff 50%, #0000ff 66.67%, #ff00ff 83.33%, #ff0000 100%);
                                accessible-role: slider;
                                accessible-label: "Hue";
                                // the round corners when drawn on the CPU (it draws gradients
                                // square): the panel's color over the gradient's corners
                                if !Skin.real-shadows : Rectangle {
                                    clip: true;
                                    Rectangle {
                                        x: -4px;
                                        y: -4px;
                                        width: parent.width + 8px;
                                        height: parent.height + 8px;
                                        border-radius: 11px;
                                        border-width: 4px;
                                        border-color: Skin.surface;
                                    }
                                }
                                Rectangle {
                                    x: root.editor-h / 360 * parent.width - 10px;
                                    y: -3px;
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    border-width: 3px;
                                    border-color: #ffffff;
                                    background: root.editor-hue-color;
                                    drop-shadow-blur: 3px;
                                    drop-shadow-color: Skin.real-shadows ? #00000090 : transparent;
                                    RingGlow {
                                        width: parent.width;
                                        height: parent.height;
                                        glow: #00000090;
                                        blur: 3px;
                                        radius: parent.border-radius;
                                        cover: parent.background;
                                        cover-border: parent.border-color;
                                        cover-border-width: parent.border-width;
                                    }
                                }
                                TouchArea {
                                    pointer-event(event) => {
                                        if event.kind == PointerEventKind.down {
                                            root.editor-hue(Math.max(0, Math.min(1, self.mouse-x / self.width)) * 360);
                                        }
                                    }
                                    moved => {
                                        root.editor-hue(Math.max(0, Math.min(1, self.mouse-x / self.width)) * 360);
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 10px;
                                // the same width: both start from 0 and share the row
                                for row in root.editor-fields : FormatBox {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    label: row.label;
                                    value: row.value;
                                    rev: row.rev;
                                    copy => { root.editor-copy(row.key); }
                                    edited(text) => { root.editor-field-edited(row.key, text); }
                                    accepted(text) => { root.editor-field-accepted(row.key, text); }
                                    blurred(text) => { }
                                }
                            }

                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                // the same width: both start from 0 and share the row
                                PillButton {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    height: 36px;
                                    text: "Cancel";
                                    clicked => { root.editor-cancel(); }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    preferred-width: 0px;
                                    border-radius: 10px;
                                    background: root.editor-use-color;
                                    border-width: 1px;
                                    border-color: root.editor-use-ink.transparentize(0.8);
                                    accessible-role: button;
                                    accessible-label: root.editor-use-label;
                                    accessible-action-default => { root.editor-use(); }
                                    Text {
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        text: root.editor-use-label;
                                        color: root.editor-use-ink;
                                        font-size: 13px;
                                        font-weight: 600;
                                        overflow: elide;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea { clicked => { root.editor-use(); } }
                                }
                            }
                        }
                    }
                }
            }

            // The "Customize formats" panel (the sliders button, or Settings).
            if root.formats-t > 0.01 : Rectangle {
                width: 100%;
                height: 100%;
                background: #00000050;
                opacity: root.formats-t;
                TouchArea { clicked => { root.formats-open = false; } }

                // beside the panel, not in it: the panel clips what is inside
                RingGlow {
                    x: formats-panel.x;
                    y: formats-panel.y;
                    width: formats-panel.width;
                    height: formats-panel.height;
                    glow: #00000050;
                    blur: 16px;
                    radius: 16px;
                }
                formats-panel := Rectangle {
                    x: parent.width - self.width - root.pad;
                    y: root.picker-top + 48px - (1 - root.formats-t) * 10px;
                    width: 260px;
                    height: Math.min(parent.height - 84px, formats-list.preferred-height);
                    background: Skin.surface;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: Skin.border;
                    drop-shadow-blur: 16px;
                    drop-shadow-color: Skin.real-shadows ? #00000050 : transparent;
                    clip: true;

                    TouchArea { }

                    ScrollView {
                        viewport-width: self.visible-width;
                        viewport-height: formats-list.preferred-height;

                        formats-list := VerticalLayout {
                            width: parent.visible-width;
                            padding: 16px;
                            spacing: 8px;

                            Text {
                                text: "Customize formats";
                                font-weight: 700;
                                color: Skin.text-main;
                                font-size: 15px;
                            }
                            Text {
                                text: "The top one is on the color card, and is what Auto copy copies.";
                                color: Skin.text-muted;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                            Rectangle { height: 1px; background: Skin.border; }

                            for option[i] in root.format-options : HorizontalLayout {
                                spacing: 6px;
                                Switch {
                                    label: option.label;
                                    checked: option.enabled;
                                    toggled(on) => { root.format-toggled(option.key, on); }
                                }
                                Text {
                                    text: option.label;
                                    color: option.enabled ? Skin.text-main : Skin.text-muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                IconButton {
                                    icon: @image-url("chevron-up.svg");
                                    label: "Move " + option.label + " up";
                                    enabled: i > 0;
                                    clicked => { root.format-moved(option.key, -1); }
                                }
                                IconButton {
                                    icon: @image-url("chevron-down.svg");
                                    label: "Move " + option.label + " down";
                                    enabled: i < root.format-options.length - 1;
                                    clicked => { root.format-moved(option.key, 1); }
                                }
                            }
                        }
                    }
                }
            }

            // Error message (e.g. a color that can't be read), at the bottom of the
            // window: a pill like the format boxes, with a red outline.
            if root.toast-t > 0.01 : Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 16px + (1 - root.toast-t) * 16px;
                width: Math.min(parent.width - 2 * root.pad, toast-row.preferred-width);
                height: 40px;
                opacity: root.toast-t;
                border-radius: self.height / 2;
                background: Skin.surface;
                border-width: 1px;
                border-color: #e5484d;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 4px;
                drop-shadow-color: Skin.real-shadows ? #00000050 : transparent;
                RingGlow {
                    width: parent.width;
                    height: parent.height;
                    glow: #00000050;
                    blur: 16px;
                    radius: parent.height / 2;
                    offset-y: 4px;
                    cover: Skin.surface;
                    cover-border: #e5484d;
                    cover-border-width: 1px;
                }

                toast-row := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 16px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: #e5484d;
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: "!";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 800;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: root.toast-text;
                        color: Skin.text-main;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        title-bar := TitleBar {
            x: 0;
            y: 0;
            width: parent.width;
            title: root.settings-open ? (root.about-open ? "About Archtoys" : "Settings")
                : root.page == 0 ? "Archtoys" : root.page == 1 ? "Color Picker" : "Text Extractor";
            menu-active: root.sidebar-mode > 0;
            menu-clicked => { root.menu-clicked(); }
            start-move => { root.window-move(); }
        }

        // the sidebar: pinned beside the toy, or opened over it
        side := Sidebar {
            property <bool> open: root.sidebar-mode > 0 || root.sidebar-shown;
            // only the icons: pinned that way, and not opened over the toy
            compact: root.sidebar-mode == 1 && !root.sidebar-shown;
            x: self.open ? 0px : -root.side-w - 2px;
            animate x { duration: 160ms; easing: ease-out; }
            visible: self.x > -root.side-w - 1px;
            y: root.title-h;
            width: self.compact ? root.rail-w : root.side-w;
            height: root.height - root.title-h;
            background: root.sidebar-mode > 0 && !root.sidebar-shown ? Skin.bg-color.transparentize(1) : Skin.bg-color;
            page: root.page;
            settings-open: root.settings-open;
            navigate(i) => { root.go(i); }
            open-settings => { root.open-settings(); }
            // the line between it and the toy
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Skin.border;
            }
        }

        // The color editor and the formats panel dim the toy; the bar and the
        // pinned sidebar beside it get the same shade, and a click there closes
        // them too.
        if root.page == 1 && (root.editor-t > 0.01 || root.formats-t > 0.01) : Rectangle {
            property <float> shade: Math.max(0.45 * root.editor-t, 0.31 * root.formats-t);
            Rectangle {
                height: root.title-h;
                background: #000000;
                opacity: parent.shade;
                y: 0;
            }
            Rectangle {
                x: 0;
                y: root.title-h;
                width: root.toy-x;
                height: root.height - root.title-h;
                background: #000000;
                opacity: parent.shade;
            }
            TouchArea {
                height: root.title-h;
                y: 0;
                clicked => {
                    if root.editor-open {
                        root.editor-close();
                    }
                    root.formats-open = false;
                }
            }
            TouchArea {
                x: 0;
                y: root.title-h;
                width: root.toy-x;
                height: root.height - root.title-h;
                clicked => {
                    if root.editor-open {
                        root.editor-close();
                    }
                    root.formats-open = false;
                }
            }
        }
    }
}
