// Text Extractor (v0.7.0): turning it on (installing Tesseract), the latest
// text, the history, and one history entry opened.
import { ScrollView } from "std-widgets.slint";
import { Skin, PillButton, ActionButton } from "common.slint";

// One extraction, as the history shows it.
export struct TextEntry {
    text: string,
    // the text on one line (for a history row)
    preview: string,
    // "English"
    language: string,
    // how sure Tesseract was, 0-100
    sure: int,
    // the text's height on screen, in pixels
    size: int,
    words: int,
    // "Today 9:41", "Yesterday", "3 Nov"
    when: string,
    // a font entry (Find font, v0.7.5), and the font found ("Georgia Bold", "Finding the font…")
    font: bool,
    font-name: string,
}

// The font finder (v0.7.5): its state, set from Rust (fontfind/page.rs).
// Text Extractor's page and Settings both read it.
export global FontFinder {
    // 0 the first time (ask), 1 searching, 2 the answer, 3 nothing matched
    in property <int> state;
    in property <image> picture;
    in property <bool> picture-gone;
    // searching
    in property <image> comparing-image;
    in property <string> comparing;
    in property <float> progress: -1;
    in property <string> count;
    in property <string> download;
    in property <string> left;
    in property <string> best;
    // the answer
    in property <image> name-image;
    in property <string> name;
    in property <int> sure;
    in property <string> size;
    in property <string> pt;
    in property <string> weight;
    in property <string> style;
    in property <color> text-color;
    in property <string> text-hex;
    in property <color> bg-color;
    in property <string> bg-hex;
    in property <string> contrast;
    in property <[string]> guesses;
    in property <int> chosen;
    in property <image> guess-image;
    in property <string> credit;
    in property <string> why;
    // its accent (blue unless...), as a fill under white text
    in property <color> accent: #2f8fdd;
    // the accent for text and lines, readable on each theme (Rust lifts or deepens it)
    in property <color> ink-on-dark: #6fb3ea;
    in property <color> ink-on-light: #1f6fae;
    out property <color> ink: Skin.pick(self.ink-on-dark, self.ink-on-light);
    // Settings: may it download fonts, and was it asked yet (the first-time card)
    in-out property <bool> online;
    in-out property <bool> asked;
    in property <string> fonts-info;
    in property <string> pictures-info;
    // an entry was opened on the page (its index, -1 for none)
    callback opened(int);
    callback allow(bool);
    callback stop();
    callback search-again();
    callback choose(int);
    callback sample(string);
    callback copy-name();
    callback delete-fonts();
    callback delete-pictures();
    callback online-changed(bool);
}

component Card inherits Rectangle {
    border-radius: 18px;
    background: Skin.surface;
    border-width: 1px;
    border-color: Skin.border;
}

// A picture of text on paper (the selection, a candidate font's drawing).
component PaperBox inherits Rectangle {
    in property <image> source;
    in property <bool> outlined;
    in property <string> empty-text;
    height: 76px;
    border-radius: 10px;
    background: #fdfdfb;
    border-width: root.outlined ? 2px : 0px;
    border-color: FontFinder.ink;
    clip: true;
    if root.source.width > 0 : Image {
        x: 14px;
        y: 8px;
        width: parent.width - 28px;
        height: parent.height - 16px;
        source: root.source;
        image-fit: contain;
        horizontal-alignment: left;
    }
    if root.source.width == 0 : Text {
        text: root.empty-text;
        color: #5d6270;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A bar in the font finder's accent.
component AccentBar inherits Rectangle {
    in property <float> fraction;
    height: 8px;
    border-radius: 4px;
    background: Skin.track;
    clip: true;
    Rectangle {
        property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
        x: root.fraction >= 0 ? 0px : (self.phase * 1.4 - 0.4) * parent.width;
        width: root.fraction >= 0 ? parent.width * Math.min(1, root.fraction) : parent.width * 0.4;
        border-radius: 4px;
        background: FontFinder.ink;
    }
}

// The first-time card's two answers: the same size, the chosen way filled.
component ChoiceButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    callback clicked;
    height: 40px;
    width: label.preferred-width + 36px;
    border-radius: 12px;
    background: root.primary ? (touch.has-hover ? FontFinder.accent.brighter(0.15) : FontFinder.accent) : (touch.has-hover ? Skin.surface-hover : Skin.bg-color);
    border-width: root.primary ? 0px : 1px;
    border-color: Skin.border;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.primary ? #ffffff : Skin.text-main;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// One point of the first-time card.
component Point inherits HorizontalLayout {
    in property <string> number;
    in property <string> text;
    spacing: 10px;
    Text { text: root.number; color: FontFinder.ink; font-size: 15px; font-weight: 700; width: 14px; }
    Text { text: root.text; color: Skin.text-main; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1; }
}

// The toy's icon, big, at the top of a centered page.
component BigIcon inherits HorizontalLayout {
    in property <image> icon;
    in property <bool> muted;
    alignment: center;
    Rectangle {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: root.muted ? Skin.surface : Skin.accent;
        border-width: root.muted ? 1px : 0px;
        border-color: Skin.border;
        Image {
            source: root.icon;
            width: 30px;
            height: 30px;
            colorize: root.muted ? Skin.text-muted : #ffffff;
        }
    }
}

component Fact inherits Rectangle {
    in property <string> label;
    in property <string> value;
    border-radius: 12px;
    background: Skin.surface;
    border-width: 1px;
    border-color: Skin.border;
    min-height: 60px;
    VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 2px;
        alignment: center;
        Text { text: root.label; color: Skin.text-muted; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; }
        Text { text: root.value; color: Skin.text-main; font-size: 17px; font-weight: 600; overflow: elide; }
    }
}

component SmallLink inherits Text {
    callback clicked;
    font-size: 14px;
    font-weight: 600;
    color: touch.has-hover ? Skin.text-main : Skin.text-muted;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    touch := TouchArea { clicked => { root.clicked(); } }
}

component SectionTitle inherits Text {
    color: Skin.text-muted;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    vertical-alignment: center;
}

// A progress bar; fraction < 0 means "working, size unknown" (a sliding bar).
component Progress inherits Rectangle {
    in property <float> fraction;
    height: 10px;
    border-radius: 5px;
    background: Skin.track;
    clip: true;
    Rectangle {
        property <float> phase: Math.mod(animation-tick() / 1ms, 1400) / 1400;
        x: root.fraction >= 0 ? 0px : (self.phase * 1.4 - 0.4) * parent.width;
        width: root.fraction >= 0 ? parent.width * Math.min(1, root.fraction) : parent.width * 0.4;
        border-radius: 5px;
        background: Skin.accent;
    }
}

// A font entry's font part: the first-time question, the search, the answer.
component FontPanel inherits VerticalLayout {
    spacing: 12px;
    SectionTitle { text: FontFinder.state == 1 ? "FONT · SEARCHING" : "FONT"; }

    // the first time: what it does, and whether it may download fonts
    if FontFinder.state == 0 : Card {
        height: ask.preferred-height;
        ask := VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 14px;
                Rectangle {
                    width: 52px;
                    height: 52px;
                    border-radius: 14px;
                    background: FontFinder.accent;
                    Text { text: "Aa"; color: #ffffff; font-size: 24px; font-weight: 700; font-family: "Noto Serif"; }
                }
                Text {
                    text: "Find the font online?";
                    color: Skin.text-main;
                    font-size: 21px;
                    font-weight: 700;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: "To name the font, Archtoys draws the text it read in fonts that could match and compares them with your selection. It always compares with the fonts on your computer first.";
                color: Skin.text-muted;
                font-size: 14px;
                wrap: word-wrap;
            }
            Point { number: "1"; text: "Turning this on lets it download fonts from the Google Fonts collection while it searches: about 10 MB once for its list, then usually 2 to 8 MB of fonts the first times, less after."; }
            Point { number: "2"; text: "Downloaded fonts stay in Archtoys' cache, so later searches are faster. You can delete them in Settings."; }
            Point { number: "3"; text: "Only font files are downloaded. Your selection and its text never leave your computer."; }
            Point { number: "4"; text: "A font entry keeps a picture of your selection in Archtoys' cache, so it can be searched again. Delete the pictures any time in Settings › Font finder › Saved pictures, the fonts found stay."; }
            // the user asked for this to be said plainly, the first time
            Rectangle {
                border-radius: 12px;
                background: Skin.pick(#262931, #f0f2f5);
                height: note.preferred-height;
                note := VerticalLayout {
                    padding: 14px;
                    spacing: 4px;
                    Text { text: "A best guess, not a sure answer"; color: Skin.text-main; font-size: 14px; font-weight: 700; }
                    Text {
                        text: "It won't always be right, and its percentages are how alike the drawings look, not a promise. Your screen's scaling, its font smoothing and hinting, the text's size, bold or styled text and how much text you select can all make it better or worse. Use it knowing that.";
                        color: Skin.text-muted;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                ChoiceButton { text: "Use only local fonts"; clicked => { FontFinder.allow(false); } }
                ChoiceButton { text: "Turn on"; primary: true; clicked => { FontFinder.allow(true); } }
            }
        }
    }

    // searching: the selection, the font being compared, the progress
    if FontFinder.state == 1 : Card {
        height: searching.preferred-height;
        searching := VerticalLayout {
            padding: 18px;
            spacing: 10px;
            SectionTitle { text: "YOUR SELECTION"; }
            PaperBox { source: FontFinder.picture; empty-text: "Picture deleted"; }
            Text { text: "Comparing: " + FontFinder.comparing; color: FontFinder.ink; font-size: 13px; font-weight: 700; overflow: elide; }
            PaperBox { source: FontFinder.comparing-image; }
            AccentBar { fraction: FontFinder.progress; }
            HorizontalLayout {
                Text { text: FontFinder.count; color: Skin.text-muted; font-size: 13px; font-family: "monospace"; horizontal-stretch: 1; }
                Text { text: FontFinder.download; color: Skin.text-muted; font-size: 13px; font-family: "monospace"; horizontal-stretch: 1; horizontal-alignment: center; }
                Text { text: FontFinder.left; color: Skin.text-muted; font-size: 13px; font-family: "monospace"; horizontal-stretch: 1; horizontal-alignment: right; }
            }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: FontFinder.best == "" ? "" : "Best so far: " + FontFinder.best;
                    color: Skin.text-main;
                    font-size: 14px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                PillButton { text: "Stop"; clicked => { FontFinder.stop(); } }
            }
        }
    }

    // the answer
    if FontFinder.state == 2 : Card {
        height: answer.preferred-height;
        answer := VerticalLayout {
            padding: 18px;
            spacing: 12px;
            SectionTitle { text: "LOOKS LIKE"; }
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    height: 46px;
                    horizontal-stretch: 1;
                    if FontFinder.name-image.width > 0 : Image {
                        width: parent.width;
                        height: parent.height;
                        source: FontFinder.name-image;
                        image-fit: contain;
                        horizontal-alignment: left;
                        colorize: Skin.text-main;
                    }
                    if FontFinder.name-image.width == 0 : Text {
                        text: FontFinder.name;
                        color: Skin.text-main;
                        font-size: 28px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: FontFinder.sure + "% sure";
                    color: FontFinder.ink;
                    font-size: 22px;
                    font-weight: 700;
                    vertical-alignment: bottom;
                }
            }
            AccentBar { fraction: FontFinder.sure / 100; }
            HorizontalLayout {
                spacing: 8px;
                Fact { label: "SIZE"; value: FontFinder.size; }
                Fact { label: "IN PT"; value: FontFinder.pt; }
                Fact { label: "WEIGHT"; value: FontFinder.weight; }
                Fact { label: "STYLE"; value: FontFinder.style; }
            }
            HorizontalLayout {
                spacing: 8px;
                Rectangle { width: 22px; height: 22px; border-radius: 5px; background: FontFinder.text-color; border-width: 1px; border-color: Skin.border; }
                Text { text: "Text " + FontFinder.text-hex; color: Skin.text-main; font-size: 13px; vertical-alignment: center; }
                Rectangle { width: 6px; }
                Rectangle { width: 22px; height: 22px; border-radius: 5px; background: FontFinder.bg-color; border-width: 1px; border-color: Skin.border; }
                Text { text: "Background " + FontFinder.bg-hex; color: Skin.text-main; font-size: 13px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Contrast " + FontFinder.contrast; color: Skin.text-muted; font-size: 13px; vertical-alignment: center; }
            }
            SectionTitle { text: "GUESSES · CLICK TO TRY ONE"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                for guess[i] in FontFinder.guesses : Rectangle {
                    height: 34px;
                    width: chip.preferred-width + 24px;
                    border-radius: 10px;
                    background: i == FontFinder.chosen ? FontFinder.accent : (chip-touch.has-hover ? Skin.surface-hover : Skin.bg-color);
                    border-width: i == FontFinder.chosen ? 0px : 1px;
                    border-color: Skin.border;
                    accessible-role: button;
                    accessible-label: guess;
                    accessible-action-default => { FontFinder.choose(i); }
                    chip := Text {
                        text: guess;
                        color: i == FontFinder.chosen ? #ffffff : Skin.text-main;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    chip-touch := TouchArea { clicked => { FontFinder.choose(i); } }
                }
            }
            SectionTitle { text: "YOUR SELECTION · THE GUESS"; }
            PaperBox { source: FontFinder.picture; empty-text: "Picture deleted"; }
            PaperBox { source: FontFinder.guess-image; outlined: true; }
            Rectangle {
                height: 34px;
                border-radius: 9px;
                background: Skin.bg-color;
                border-width: 1px;
                border-color: sample-input.has-focus ? FontFinder.ink : Skin.border;
                sample-input := TextInput {
                    x: 12px;
                    width: parent.width - 24px;
                    color: Skin.text-main;
                    font-size: 14px;
                    vertical-alignment: center;
                    single-line: true;
                    edited => { FontFinder.sample(self.text); }
                }
                if sample-input.text == "" : Text {
                    x: 12px;
                    text: "Type here to see any text in the guess";
                    color: Skin.text-muted;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: Skin.border; }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: FontFinder.credit;
                    color: Skin.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                PillButton { text: "Copy name"; clicked => { FontFinder.copy-name(); } }
            }
        }
    }

    // nothing matched well enough (or the search couldn't run)
    if FontFinder.state == 3 : Card {
        height: none.preferred-height;
        none := VerticalLayout {
            padding: 18px;
            spacing: 8px;
            Text { text: "No font matched well enough"; color: Skin.text-main; font-size: 16px; font-weight: 700; }
            Text { text: FontFinder.why; color: Skin.text-muted; font-size: 14px; wrap: word-wrap; }
        }
    }

    if FontFinder.state >= 2 && !FontFinder.picture-gone : HorizontalLayout {
        alignment: start;
        SmallLink {
            text: "Search again";
            color: FontFinder.ink;
            clicked => { FontFinder.search-again(); }
        }
    }
}

export component TextExtractorPage inherits Rectangle {
    // 0 off, 1 installing, 2 ready, 3 Archtoys can't install it here
    in property <int> state;
    // "Arch Linux"
    in property <string> distro;
    // the Tesseract already there before turning on ("4.1.1"), or ""
    in property <string> installed-version;
    in property <float> install-fraction: -1;
    // "9.3 of 15.0 MB · 2.1 MB/s · about 3 s left"
    in property <string> install-stats;
    // "Downloading tesseract with pacman"
    in property <string> install-stage;
    // why it can't be installed, or what went wrong
    in property <string> message;
    in property <string> hotkey;
    in property <[TextEntry]> history;
    // the history entry opened (-1: none)
    in-out property <int> detail: -1;
    changed detail => { FontFinder.opened(self.detail); }
    callback turn-on();
    callback cancel-install();
    callback check-again();
    callback extract();
    callback copy-text(string);
    callback delete-entry(int);
    callback clear-history();

    // the centered column of the off and installing pages
    property <length> column-w: Math.min(root.width - 48px, 500px);

    // --- Off (or can't be installed here): what it is, and Turn on ---
    if root.state == 0 || root.state == 3 : VerticalLayout {
        padding: 24px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: root.column-w;
                spacing: 16px;
                BigIcon { icon: @image-url("extract.svg"); }
                Text {
                    text: "Copy text from anywhere on screen";
                    color: Skin.text-main;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    text: root.state == 3 ? root.message
                        : "Text Extractor reads the text in any part of your screen, even in images and videos, with Tesseract, a free text-recognition engine. Archtoys installs it for you from "
                            + (root.distro == "" ? "your system" : root.distro) + "'s packages, about 15 MB.";
                    color: Skin.text-muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.state == 0 && root.installed-version != "" : Text {
                    text: "Tesseract " + root.installed-version + " is already installed. Archtoys still asks for your password to update it from your system's packages, so you have a version Archtoys works with.";
                    color: Skin.text-muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.state == 0 && root.message != "" : Text {
                    text: root.message;
                    color: #e5484d;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.state == 0 : Card {
                    // room for the note on two lines (wrapped text doesn't grow its box)
                    min-height: 58px;
                    border-radius: 14px;
                    HorizontalLayout {
                        padding: 12px;
                        padding-left: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("lock.svg");
                                width: 18px;
                                height: 18px;
                                colorize: Skin.text-muted;
                            }
                        }
                        Text {
                            text: "Your system asks for your password in its own window. Archtoys never sees it.";
                            color: Skin.text-muted;
                            font-size: 14px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    if root.state == 0 : ActionButton {
                        icon: @image-url("power.svg");
                        text: "Turn on";
                        primary: true;
                        clicked => { root.turn-on(); }
                    }
                    if root.state == 3 : ActionButton {
                        icon: @image-url("search.svg");
                        text: "Check again";
                        clicked => { root.check-again(); }
                    }
                }
            }
        }
    }

    // --- Installing ---
    if root.state == 1 : VerticalLayout {
        padding: 24px;
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: root.column-w;
                spacing: 16px;
                BigIcon { icon: @image-url("extract.svg"); }
                Text {
                    text: "Installing Tesseract";
                    color: Skin.text-main;
                    font-size: 22px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.install-stage;
                    color: Skin.text-muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Progress { fraction: root.install-fraction; }
                if root.install-stats != "" : Text {
                    text: root.install-stats;
                    color: Skin.text-muted;
                    font-size: 13px;
                    font-family: "monospace";
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    PillButton { text: "Cancel"; clicked => { root.cancel-install(); } }
                }
            }
        }
    }

    // --- Ready: Extract, the latest text, the history ---
    if root.state == 2 && root.detail < 0 : ScrollView {
        content-width: self.visible-width;
        content-height: ready-list.preferred-height;
        ready-list := VerticalLayout {
            width: parent.visible-width;
            padding: 20px;
            padding-top: 10px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                ActionButton {
                    icon: @image-url("extract.svg");
                    text: "Extract text";
                    label: "Extract text from the screen";
                    clicked => { root.extract(); }
                }
                Rectangle { horizontal-stretch: 1; }
                // the hotkey, as a key
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 30px;
                        width: key-text.preferred-width + 20px;
                        border-radius: 8px;
                        background: Skin.surface;
                        border-width: 1px;
                        border-color: Skin.border;
                        key-text := Text {
                            text: root.hotkey;
                            color: Skin.text-muted;
                            font-size: 13px;
                            font-family: "monospace";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // nothing yet: how it works
            if root.history.length == 0 : Card {
                min-height: 280px;
                VerticalLayout {
                    padding: 28px;
                    spacing: 12px;
                    alignment: center;
                    BigIcon { icon: @image-url("extract.svg"); muted: true; }
                    Text {
                        text: "Nothing extracted yet";
                        color: Skin.text-main;
                        font-size: 18px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Press Extract text (or " + root.hotkey + "), then drag over any text on your screen. Archtoys finds its language by itself, and Enter copies it.";
                        color: Skin.text-muted;
                        font-size: 15px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }

            if root.history.length > 0 : VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 8px;
                    SectionTitle {
                        text: "LATEST · " + root.history[0].language + " · " + root.history[0].sure + "% sure";
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    PillButton {
                        text: "Copy";
                        clicked => { root.copy-text(latest.text); }
                    }
                }
                Card {
                    height: Math.max(96px, Math.min(latest.preferred-height + 28px, 240px));
                    clip: true;
                    latest := TextInput {
                        x: 16px;
                        y: 14px;
                        width: parent.width - 32px;
                        text: root.history[0].text;
                        color: Skin.text-main;
                        font-size: 15px;
                        wrap: word-wrap;
                        single-line: false;
                    }
                }
            }

            if root.history.length > 0 : HorizontalLayout {
                padding-top: 4px;
                SectionTitle {
                    text: "HISTORY · " + root.history.length;
                    horizontal-stretch: 1;
                }
                SmallLink {
                    text: "Clear all";
                    clicked => { root.clear-history(); }
                }
            }
            for entry[i] in root.history : Rectangle {
                height: 54px;
                border-radius: 14px;
                background: row-touch.has-hover ? Skin.surface-hover : Skin.surface;
                border-width: 1px;
                border-color: Skin.border;
                animate background { duration: 120ms; }
                accessible-role: button;
                accessible-label: entry.text;
                row-touch := TouchArea { clicked => { root.detail = i; } }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    spacing: 12px;
                    // a font entry: its own look
                    if entry.font : Rectangle {
                        width: 30px;
                        height: 24px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 7px;
                        background: FontFinder.accent;
                        Text { text: "Aa"; color: #ffffff; font-size: 13px; font-weight: 700; font-family: "Noto Serif"; }
                    }
                    Text {
                        text: entry.preview;
                        color: Skin.text-main;
                        font-size: 15px;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: (entry.font ? entry.font-name : entry.language) + " · " + entry.when;
                        color: entry.font ? FontFinder.ink : Skin.text-muted;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 40px;
                        accessible-role: button;
                        accessible-label: "Delete this entry";
                        Rectangle {
                            width: 30px;
                            height: 30px;
                            border-radius: 8px;
                            background: del-touch.has-hover ? #e5484d26 : transparent;
                        }
                        Text {
                            text: "✕";
                            color: del-touch.has-hover ? #e5484d : Skin.text-muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        del-touch := TouchArea { clicked => { root.delete-entry(i); } }
                    }
                }
            }
        }
    }

    // --- One history entry, opened ---
    if root.state == 2 && root.detail >= 0 && root.detail < root.history.length : detail-view := ScrollView {
        property <TextEntry> entry: root.history[root.detail];
        content-width: self.visible-width;
        content-height: detail-list.preferred-height;
        detail-list := VerticalLayout {
            width: parent.visible-width;
            padding: 20px;
            padding-top: 10px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 8px;
                SmallLink {
                    text: "‹ History · " + detail-view.entry.when;
                    vertical-alignment: center;
                    clicked => { root.detail = -1; }
                }
                Rectangle { horizontal-stretch: 1; }
                PillButton {
                    text: "Copy";
                    clicked => { root.copy-text(full.text); }
                }
            }
            Card {
                height: Math.max(96px, full.preferred-height + 28px);
                full := TextInput {
                    x: 16px;
                    y: 14px;
                    width: parent.width - 32px;
                    text: detail-view.entry.text;
                    color: Skin.text-main;
                    font-size: 15px;
                    wrap: word-wrap;
                    single-line: false;
                }
            }
            HorizontalLayout {
                spacing: 10px;
                Fact { label: "LANGUAGE"; value: detail-view.entry.language; }
                Fact { label: "SURE"; value: detail-view.entry.sure + "%"; }
                Fact { label: "TEXT SIZE"; value: detail-view.entry.size + " px"; }
                Fact { label: "WORDS"; value: detail-view.entry.words; }
            }
            if detail-view.entry.font : FontPanel { }
            HorizontalLayout {
                alignment: end;
                SmallLink {
                    text: "Delete this entry";
                    color: #e5484d;
                    clicked => {
                        root.delete-entry(root.detail);
                        root.detail = -1;
                    }
                }
            }
        }
    }
}
