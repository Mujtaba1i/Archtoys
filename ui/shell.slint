// The app's frame (v0.7.0): the bar with the menu, the sidebar and the Home page.
import { ScrollView } from "std-widgets.slint";
import { Skin, Switch, Keycaps } from "common.slint";

// A button in the bar (the menu).
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    // as wide as the sidebar's items and with their 20 px icons (v0.7.3)
    width: 44px;
    height: 34px;
    border-radius: 9px;
    background: root.active ? Skin.surface
        : touch.pressed ? Skin.border
        : touch.has-hover ? Skin.surface-hover : Skin.surface-hover.transparentize(1);
    border-width: root.active ? 1px : 0px;
    border-color: Skin.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.active ? Skin.accent : Skin.icon-tint;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The bar at the top: the menu (click: keep the sidebar open; rest on it:
// open it over the toy), the logo and the page's name. Drag it to move the
// window (for desktops without a title bar on it, issue #11).
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> menu-active;
    // where the page's content starts (the pinned sidebar's width + its padding)
    in property <length> title-x;
    out property <bool> menu-hovered: menu.hovered;
    callback menu-clicked();
    callback start-move();
    height: 40px;

    // a press that moves a few pixels is a drag (a click stays a click)
    TouchArea {
        property <length> press-x;
        property <length> press-y;
        property <bool> moving;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.moving = false;
            }
        }
        moved => {
            if !self.moving && (Math.abs(self.mouse-x - self.press-x) > 3px || Math.abs(self.mouse-y - self.press-y) > 3px) {
                self.moving = true;
                root.start-move();
            }
        }
    }

    // the menu sits on the sidebar's icon column (centered 30 px in)
    menu := BarButton {
        x: 8px;
        y: (root.height - self.height) / 2;
        icon: @image-url("menu.svg");
        label: "Menu";
        active: root.menu-active;
        clicked => { root.menu-clicked(); }
    }
    // the logo and the page's name start where the page does (after the
    // pinned sidebar), or right after the menu when no sidebar is pinned
    HorizontalLayout {
        x: max(menu.x + menu.width + 8px, root.title-x);
        width: root.width - self.x - 6px;
        spacing: 7px;
        animate x { duration: 160ms; easing: ease-out; }
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../packaging/archtoys-64.png");
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: root.title;
            color: Skin.text-main;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// One row in the sidebar.
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    // only the icon (the sidebar pinned as icons)
    in property <bool> compact;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: root.active ? Skin.surface : touch.has-hover ? Skin.surface-hover : Skin.surface-hover.transparentize(1);
    border-width: root.active ? 1px : 0px;
    border-color: Skin.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 11px;
        padding-right: root.compact ? 0px : 9px;
        spacing: 11px;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: root.active ? Skin.accent : Skin.icon-tint;
            }
        }
        if !root.compact : Text {
            text: root.label;
            color: root.active ? Skin.accent : Skin.text-main;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The sidebar: the toys, and Settings at the bottom. Pages: 0 Home,
// 1 Color Picker, 2 Text Extractor, 3 Screen Ruler.
export component Sidebar inherits Rectangle {
    in property <int> page;
    // the ruler's icon (its teeth follow the last measurement)
    in property <image> ruler-icon: @image-url("ruler.svg");
    in property <bool> settings-open;
    // only the icons
    in property <bool> compact;
    // the mouse is over it (its buttons take the hover from the area below them)
    out property <bool> hovered: hover.has-hover || home.hovered || picker.hovered || text.hovered || ruler.hovered || settings.hovered;
    callback navigate(int);
    callback open-settings();
    hover := TouchArea { }
    VerticalLayout {
        padding: 8px;
        padding-top: 4px;
        spacing: 6px;
        home := NavItem {
            compact: root.compact;
            icon: @image-url("home.svg");
            label: "Home";
            active: root.page == 0 && !root.settings-open;
            clicked => { root.navigate(0); }
        }
        picker := NavItem {
            compact: root.compact;
            icon: @image-url("pick.svg");
            label: "Color Picker";
            active: root.page == 1 && !root.settings-open;
            clicked => { root.navigate(1); }
        }
        text := NavItem {
            compact: root.compact;
            icon: @image-url("text.svg");
            label: "Text Extractor";
            active: root.page == 2 && !root.settings-open;
            clicked => { root.navigate(2); }
        }
        ruler := NavItem {
            compact: root.compact;
            icon: root.ruler-icon;
            label: "Screen Ruler";
            active: root.page == 3 && !root.settings-open;
            clicked => { root.navigate(3); }
        }
        Rectangle { vertical-stretch: 1; }
        settings := NavItem {
            compact: root.compact;
            icon: @image-url("settings.svg");
            label: "Settings";
            active: root.settings-open;
            clicked => { root.open-settings(); }
        }
    }
}

// A toy on Home (v0.8.0): its icon in a soft tile, name, what it does and
// its hotkey as keycaps (FancyZones-like toys can show other words after
// them). The rows sit in one card, a line between them.
component ToyRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> hotkey;
    in property <bool> first;
    in property <bool> last;
    callback clicked;
    height: 80px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-action-default => { root.clicked(); }
    // the hover, with the card's corners on the first and last row (the CPU
    // renderer clips only to rectangles)
    Rectangle {
        border-top-left-radius: root.first ? 15px : 0;
        border-top-right-radius: root.first ? 15px : 0;
        border-bottom-left-radius: root.last ? 15px : 0;
        border-bottom-right-radius: root.last ? 15px : 0;
        background: touch.has-hover ? Skin.surface-hover : Skin.surface-hover.transparentize(1);
        animate background { duration: 120ms; }
    }
    if !root.first : Rectangle {
        y: 0;
        height: 1px;
        background: Skin.border;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        alignment: stretch;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 13px;
                background: Skin.accent.transparentize(0.86);
                border-width: 1px;
                border-color: Skin.accent.transparentize(0.55);
                Image {
                    source: root.icon;
                    width: 24px;
                    height: 24px;
                    colorize: Skin.pick(#5cb8f5, #1a7fc1);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Skin.text-main;
                font-size: 18px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.subtitle;
                color: Skin.text-muted;
                font-size: 14px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Keycaps { hotkey: root.hotkey; }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A Micro-toy on Home (v0.8.0): one line, its name, what it does, its hotkey
// and its switch. Off, all but the switch is grayed out.
component MicroRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> hotkey;
    in property <bool> on;
    in property <bool> first;
    callback toggled(bool);
    height: 60px;
    if !root.first : Rectangle {
        y: 0;
        height: 1px;
        background: Skin.border;
    }
    HorizontalLayout {
        padding-left: 18px;
        padding-right: 18px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 10px;
            horizontal-stretch: 1;
            opacity: root.on ? 1 : 0.4;
            animate opacity { duration: 120ms; }
            Text {
                text: root.title;
                color: Skin.text-main;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
            // shown when it fits (a wider window): a few letters and "…" say nothing
            Text {
                text: root.subtitle;
                color: Skin.text-muted;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                opacity: self.width >= min(self.preferred-width, 120px) ? 1 : 0;
            }
        }
        VerticalLayout {
            alignment: center;
            opacity: root.on ? 1 : 0.4;
            animate opacity { duration: 120ms; }
            Keycaps { hotkey: root.hotkey; }
        }
        VerticalLayout {
            alignment: center;
            Switch {
                label: root.title;
                checked: root.on;
                toggled(on) => { root.toggled(on); }
            }
        }
    }
}

// Home (v0.8.0): the toys, one row each in one card, and the Micro-toys,
// a switch each (they have no page of their own). Recent is gone: each toy
// keeps its own history.
export component HomePage inherits Rectangle {
    in property <string> picker-hotkey;
    in property <string> text-hotkey;
    in property <string> ruler-hotkey;
    in property <string> screenshot-hotkey;
    in property <image> ruler-icon: @image-url("ruler.svg");
    in property <bool> micro-screenshot;
    callback open-toy(int);
    callback micro-toggled(bool);
    home-scroll := ScrollView {
        // its width is the window's, not its content's (as in Settings)
        content-width: self.visible-width;
        content-height: home-list.preferred-height;
        home-list := VerticalLayout {
            width: home-scroll.visible-width;
            padding: 20px;
            padding-top: 10px;
            spacing: 14px;
            alignment: start;
            Text {
                text: "TOYS-BOX";
                color: Skin.text-muted;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }
            Rectangle {
                border-radius: 16px;
                background: Skin.surface;
                border-width: 1px;
                border-color: Skin.border;
                VerticalLayout {
                    ToyRow {
                        first: true;
                        icon: @image-url("pick.svg");
                        title: "Color Picker";
                        subtitle: "Pick, name and copy any pixel";
                        hotkey: root.picker-hotkey;
                        clicked => { root.open-toy(1); }
                    }
                    ToyRow {
                        icon: @image-url("text.svg");
                        title: "Text Extractor";
                        subtitle: "Copy text from anywhere on screen";
                        hotkey: root.text-hotkey;
                        clicked => { root.open-toy(2); }
                    }
                    ToyRow {
                        icon: root.ruler-icon;
                        title: "Screen Ruler";
                        subtitle: "Measure anything on screen";
                        hotkey: root.ruler-hotkey;
                        last: true;
                        clicked => { root.open-toy(3); }
                    }
                }
            }
            Text {
                text: "MICRO-TOYS";
                color: Skin.text-muted;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }
            Rectangle {
                border-radius: 16px;
                background: Skin.surface;
                border-width: 1px;
                border-color: Skin.border;
                VerticalLayout {
                    MicroRow {
                        first: true;
                        title: "Screenshot to clipboard";
                        subtitle: "Copy an area to the clipboard";
                        hotkey: root.screenshot-hotkey;
                        on: root.micro-screenshot;
                        toggled(on) => { root.micro-toggled(on); }
                    }
                }
            }
        }
    }
}
