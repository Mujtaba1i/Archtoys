// The app's frame (v0.7.0): the bar with the menu, the sidebar and the Home page.
import { ScrollView } from "std-widgets.slint";
import { Skin } from "common.slint";

// A button in the bar (the menu).
component BarButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    // as wide as the sidebar's items and with their 20 px icons (v0.7.3)
    width: 44px;
    height: 34px;
    border-radius: 9px;
    background: root.active ? Skin.surface
        : touch.pressed ? Skin.border
        : touch.has-hover ? Skin.surface-hover : Skin.surface-hover.transparentize(1);
    border-width: root.active ? 1px : 0px;
    border-color: Skin.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        source: root.icon;
        width: 20px;
        height: 20px;
        colorize: root.active ? Skin.accent : Skin.icon-tint;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The bar at the top: the menu (click: keep the sidebar open; rest on it:
// open it over the toy), the logo and the page's name. Drag it to move the
// window (for desktops without a title bar on it, issue #11).
export component TitleBar inherits Rectangle {
    in property <string> title;
    in property <bool> menu-active;
    // where the page's content starts (the pinned sidebar's width + its padding)
    in property <length> title-x;
    out property <bool> menu-hovered: menu.hovered;
    callback menu-clicked();
    callback start-move();
    height: 40px;

    // a press that moves a few pixels is a drag (a click stays a click)
    TouchArea {
        property <length> press-x;
        property <length> press-y;
        property <bool> moving;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.press-x = self.mouse-x;
                self.press-y = self.mouse-y;
                self.moving = false;
            }
        }
        moved => {
            if !self.moving && (Math.abs(self.mouse-x - self.press-x) > 3px || Math.abs(self.mouse-y - self.press-y) > 3px) {
                self.moving = true;
                root.start-move();
            }
        }
    }

    // the menu sits on the sidebar's icon column (centered 30 px in)
    menu := BarButton {
        x: 8px;
        y: (root.height - self.height) / 2;
        icon: @image-url("menu.svg");
        label: "Menu";
        active: root.menu-active;
        clicked => { root.menu-clicked(); }
    }
    // the logo and the page's name start where the page does (after the
    // pinned sidebar), or right after the menu when no sidebar is pinned
    HorizontalLayout {
        x: max(menu.x + menu.width + 8px, root.title-x);
        width: root.width - self.x - 6px;
        spacing: 7px;
        animate x { duration: 160ms; easing: ease-out; }
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../packaging/archtoys-64.png");
                width: 18px;
                height: 18px;
            }
        }
        Text {
            text: root.title;
            color: Skin.text-main;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// One row in the sidebar.
component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    // only the icon (the sidebar pinned as icons)
    in property <bool> compact;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    height: 40px;
    border-radius: 10px;
    background: root.active ? Skin.surface : touch.has-hover ? Skin.surface-hover : Skin.surface-hover.transparentize(1);
    border-width: root.active ? 1px : 0px;
    border-color: Skin.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: root.compact ? 0px : 11px;
        padding-right: root.compact ? 0px : 9px;
        spacing: 11px;
        alignment: root.compact ? LayoutAlignment.center : LayoutAlignment.stretch;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 20px;
                height: 20px;
                colorize: root.active ? Skin.accent : Skin.icon-tint;
            }
        }
        if !root.compact : Text {
            text: root.label;
            color: root.active ? Skin.accent : Skin.text-main;
            font-size: 14px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The sidebar: the toys, and Settings at the bottom. Pages: 0 Home,
// 1 Color Picker, 2 Text Extractor, 3 Screen Ruler.
export component Sidebar inherits Rectangle {
    in property <int> page;
    // the ruler's icon (its teeth follow the last measurement)
    in property <image> ruler-icon: @image-url("ruler.svg");
    in property <bool> settings-open;
    // only the icons
    in property <bool> compact;
    // the mouse is over it (its buttons take the hover from the area below them)
    out property <bool> hovered: hover.has-hover || home.hovered || picker.hovered || text.hovered || ruler.hovered || settings.hovered;
    callback navigate(int);
    callback open-settings();
    hover := TouchArea { }
    VerticalLayout {
        padding: 8px;
        padding-top: 4px;
        spacing: 6px;
        home := NavItem {
            compact: root.compact;
            icon: @image-url("home.svg");
            label: "Home";
            active: root.page == 0 && !root.settings-open;
            clicked => { root.navigate(0); }
        }
        picker := NavItem {
            compact: root.compact;
            icon: @image-url("pick.svg");
            label: "Color Picker";
            active: root.page == 1 && !root.settings-open;
            clicked => { root.navigate(1); }
        }
        text := NavItem {
            compact: root.compact;
            icon: @image-url("text.svg");
            label: "Text Extractor";
            active: root.page == 2 && !root.settings-open;
            clicked => { root.navigate(2); }
        }
        ruler := NavItem {
            compact: root.compact;
            icon: root.ruler-icon;
            label: "Screen Ruler";
            active: root.page == 3 && !root.settings-open;
            clicked => { root.navigate(3); }
        }
        Rectangle { vertical-stretch: 1; }
        settings := NavItem {
            compact: root.compact;
            icon: @image-url("settings.svg");
            label: "Settings";
            active: root.settings-open;
            clicked => { root.open-settings(); }
        }
    }
}

// A toy on Home: its icon, name, what it does and its hotkey.
component ToyCard inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> subtitle;
    in property <string> hotkey;
    callback clicked;
    min-height: 190px;
    border-radius: 18px;
    background: touch.has-hover ? Skin.surface-hover : Skin.surface;
    border-width: 1px;
    border-color: touch.has-hover ? Skin.accent : Skin.border;
    animate background, border-color { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: 18px;
        y: 18px;
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: Skin.accent;
        Image {
            source: root.icon;
            width: 24px;
            height: 24px;
            colorize: #ffffff;
        }
    }
    VerticalLayout {
        padding: 18px;
        spacing: 5px;
        alignment: end;
        Text {
            text: root.title;
            color: Skin.text-main;
            font-size: 18px;
            font-weight: 700;
        }
        Text {
            text: root.subtitle;
            color: Skin.text-muted;
            font-size: 14px;
            wrap: word-wrap;
        }
        Text {
            text: root.hotkey;
            color: Skin.accent;
            font-size: 13px;
            font-family: "monospace";
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// A recent result on Home: the last color, the last text.
component RecentCard inherits Rectangle {
    in property <string> label;
    in property <string> title;
    in property <string> detail;
    in property <color> swatch: transparent;
    // an icon on a tile instead of a swatch (the ruler's)
    in property <image> icon;
    in property <color> icon-color;
    callback clicked;
    height: 76px;
    border-radius: 16px;
    background: touch.has-hover ? Skin.surface-hover : Skin.surface;
    border-width: 1px;
    border-color: Skin.border;
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.label + ": " + root.title;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        if root.swatch.alpha > 0 : Rectangle {
            width: 48px;
            border-radius: 12px;
            background: root.swatch;
            border-width: 1px;
            border-color: Skin.border;
        }
        if root.icon.width > 0 : Rectangle {
            width: 48px;
            border-radius: 12px;
            background: Skin.surface-hover;
            Image {
                source: root.icon;
                width: 26px;
                height: 26px;
                colorize: root.icon-color;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.label;
                color: Skin.text-muted;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 0.8px;
            }
            Text {
                text: root.title;
                color: Skin.text-main;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }
            if root.detail != "" : Text {
                text: root.detail;
                color: Skin.text-muted;
                font-size: 13px;
                overflow: elide;
            }
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// Home: the toys, and what you did last with them.
export component HomePage inherits Rectangle {
    in property <string> picker-hotkey;
    in property <string> text-hotkey;
    in property <string> ruler-hotkey;
    in property <image> ruler-icon: @image-url("ruler.svg");
    in property <color> ruler-line;
    in property <color> last-color;
    // "#2D5C76", and its name
    in property <string> last-color-value;
    in property <string> last-color-name;
    // the latest extracted text on one line ("" when there is none)
    in property <string> last-text;
    in property <string> last-text-detail;
    // the latest measurement ("" when there is none) and "Spacing · Today 2:20 PM"
    in property <string> last-measure;
    in property <string> last-measure-detail;
    callback open-toy(int);
    // each toy card: half the row (the page's padding is 20 px each side, 14 px between)
    property <length> card-width: (home-scroll.visible-width - 2 * 20px - 14px) / 2;
    home-scroll := ScrollView {
        // its width is the window's, not its content's (as in Settings), so
        // the toy cards can each take exactly half of it
        content-width: self.visible-width;
        content-height: home-list.preferred-height;
        home-list := VerticalLayout {
            width: home-scroll.visible-width;
            padding: 20px;
            padding-top: 10px;
            spacing: 14px;
            alignment: start;
            Text {
                text: "YOUR TOYS";
                color: Skin.text-muted;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                spacing: 14px;
                ToyCard {
                    icon: @image-url("pick.svg");
                    width: root.card-width;
                    title: "Color Picker";
                    subtitle: "Pick, name and copy any pixel";
                    hotkey: root.picker-hotkey;
                    clicked => { root.open-toy(1); }
                }
                ToyCard {
                    icon: @image-url("text.svg");
                    width: root.card-width;
                    title: "Text Extractor";
                    subtitle: "Copy text from anywhere on screen";
                    hotkey: root.text-hotkey;
                    clicked => { root.open-toy(2); }
                }
            }
            HorizontalLayout {
                spacing: 14px;
                ToyCard {
                    icon: root.ruler-icon;
                    width: root.card-width;
                    title: "Screen Ruler";
                    subtitle: "Measure anything on screen";
                    hotkey: root.ruler-hotkey;
                    clicked => { root.open-toy(3); }
                }
                Rectangle { }
            }
            Text {
                text: "RECENT";
                color: Skin.text-muted;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 1px;
            }
            if root.last-measure != "" : RecentCard {
                label: "RULER";
                title: root.last-measure;
                detail: root.last-measure-detail;
                icon: @image-url("spacing.svg");
                icon-color: root.ruler-line;
                clicked => { root.open-toy(3); }
            }
            RecentCard {
                label: "COLOR";
                title: root.last-color-value;
                detail: root.last-color-name;
                swatch: root.last-color;
                clicked => { root.open-toy(1); }
            }
            RecentCard {
                label: "TEXT";
                title: root.last-text != "" ? root.last-text : "Nothing extracted yet";
                detail: root.last-text != "" ? root.last-text-detail : "Press " + root.text-hotkey + " and drag over any text";
                clicked => { root.open-toy(2); }
            }
            if root.last-measure == "" : RecentCard {
                label: "RULER";
                title: "Nothing measured yet";
                detail: "Press " + root.ruler-hotkey + " and point at anything";
                clicked => { root.open-toy(3); }
            }
        }
    }
}
